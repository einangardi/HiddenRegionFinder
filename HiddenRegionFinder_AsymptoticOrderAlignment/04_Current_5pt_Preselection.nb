Notebook[{

Cell[CellGroupData[{
Cell["Current 5-point topology preselection", "Title",ExpressionUUID->"b9bd2e67-095a-4ef2-bb6f-33226cfed04a"],

Cell["\<\
Current preselection notebook: recursive derivative preselection only, with \
the handoff fixture used by the five-point HRF scan.\
\>", "Text",ExpressionUUID->"1e2c3847-8be0-4a6d-b5cb-61bc19196212"],

Cell["Setup", "Section",ExpressionUUID->"c7246b7f-149f-4c0c-bfb2-87714d1d9d4d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"$HRFQuietReports", "=", "True"}], ";", 
  RowBox[{"Get", "[", 
   RowBox[{"FileNameJoin", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"NotebookDirectory", "[", "]"}], ",", 
      "\"\<HRF_RecursiveDerivativePreselection.wl\>\""}], "}"}], "]"}], "]"}],
   ";"}]], "Input",
 CellLabel->"In[1]:=",ExpressionUUID->"073a60e4-a325-4ec4-bcb7-43822e787ade"],

Cell["Run recursive derivative preselection", "Section",ExpressionUUID->"a2048f31-dc39-416d-a7f1-231740927c87"],

Cell["\<\
This produces the 70 representative topology handoff. PreselectionZeroVars \
are diagnostic provenance for the recursive sign test; HRF still receives the \
original listed graph.\
\>", "Text",ExpressionUUID->"4228912d-46b4-4948-81a6-97bc3a9f72d7"],

Cell[BoxData[
 RowBox[{
  RowBox[{"RDScan", "=", 
   RowBox[{"hrfRunRecursiveDerivativePreselection", "[", "]"}]}], ";", 
  RowBox[{"RDScan", "[", "\"\<Summary\>\"", "]"}]}]], "Input",
 CellLabel->"In[2]:=",ExpressionUUID->"29871244-728a-454e-b83d-46957e8d8fff"],

Cell[BoxData[
 RowBox[{"RDScan", "[", "\"\<CandidateDataset\>\"", "]"}]], "Input",
 CellLabel->"In[3]:=",ExpressionUUID->"f2985f63-679a-4391-81d9-c93e68b66a0d"],

Cell[BoxData[
 RowBox[{"hrfRecursiveCandidateDrawingGrid", "[", 
  RowBox[{
   RowBox[{"Take", "[", 
    RowBox[{
     RowBox[{"RDScan", "[", "\"\<CandidateRows\>\"", "]"}], ",", 
     RowBox[{"UpTo", "[", "20", "]"}]}], "]"}], ",", "2"}], "]"}]], "Input",
 CellLabel->"In[4]:=",ExpressionUUID->"14a38e67-2f36-4ae7-9a2a-3d2bdd97100f"],

Cell["Export handoff fixture", "Section",ExpressionUUID->"a449117f-b1b2-43a9-859a-19876d9d5404"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Export", "[", 
   RowBox[{
    RowBox[{"FileNameJoin", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"NotebookDirectory", "[", "]"}], ",", 
       "\"\<RecursiveDerivativePreselectionHandoff.csv\>\""}], "}"}], "]"}], 
    ",", 
    RowBox[{"hrfRecursiveCSVTable", "[", 
     RowBox[{"RDScan", "[", "\"\<CandidateHandoffRows\>\"", "]"}], "]"}]}], 
   "]"}], ";", 
  RowBox[{
   RowBox[{"RDScan", "[", "\"\<CandidateHandoffRows\>\"", "]"}], ">>", 
   InterpretationBox[
    RowBox[{"FileNameJoin", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"NotebookDirectory", "[", "]"}], ",", 
       "\"\<RecursiveDerivativePreselectionHandoff.wl\>\""}], "}"}], "]"}],
    FileNameJoin[{
      NotebookDirectory[], "RecursiveDerivativePreselectionHandoff.wl"}],
    Editable->False]}], ";"}]], "Input",
 CellLabel->"In[5]:=",ExpressionUUID->"048b55d2-af67-4904-bf91-1b20017f4b9f"]
}, Open  ]]
},
