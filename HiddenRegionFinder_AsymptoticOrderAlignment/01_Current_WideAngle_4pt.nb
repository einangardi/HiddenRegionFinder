Notebook[{

Cell[CellGroupData[{
Cell["Current wide-angle 4-point examples", "Title",ExpressionUUID->"b5dc92e9-100e-451d-b6ce-e54e0f6755ed"],

Cell["\<\
Current wide-angle path only: polynomial factors, generator physics filter, \
and exact coverage scaling.\
\>", "Text",ExpressionUUID->"c4677640-c8de-4b70-8623-a25b51b1104a"],

Cell["Setup", "Section",ExpressionUUID->"e0abf32b-75ff-460d-80f6-8676dc3674e1"],

Cell["\<\
This notebook uses the current polynomial-factor path and exact coverage \
scaling. No comparison route is run on load.\
\>", "Text",ExpressionUUID->"f26e1471-642d-44f8-84b3-e0c1f79f823b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"$HRFQuietReports", "=", "True"}], ";", 
  RowBox[{"$HRFExample01Report", "=", "False"}], ";", 
  RowBox[{"$HRFExample04Report", "=", "True"}], ";", 
  RowBox[{"$HRFScalingReport", "=", "False"}], ";", 
  RowBox[{"$HRFRunCrownInteriorScanOnLoad", "=", "False"}], ";", 
  RowBox[{"$HRFRunSuperCrownInteriorScan", "=", "False"}], ";", 
  RowBox[{"$HRFRunSuperCrownBoundaryScanOnLoad", "=", "False"}], ";", 
  RowBox[{"$HRFRunHyperCrownInteriorScan", "=", "False"}], ";", 
  RowBox[{"$HRFRunHyperCrownBoundaryScansOnLoad", "=", "False"}], ";", 
  RowBox[{"$HRFRunDivingBeetleDiagnosticsOnLoad", "=", "False"}], ";", 
  RowBox[{"$HRFRunDivingBeetleInteriorScanOnLoad", "=", "False"}], ";", 
  RowBox[{"$HRFRunDBFullBoundaryScan", "=", "False"}], ";", 
  RowBox[{"$HRFRunDeepBoundaryScan", "=", "False"}], ";", 
  RowBox[{"$HRFEx04CompareBinomialQ", "=", "False"}], ";", 
  RowBox[{"$HRFEx04TrimScanStorageQ", "=", "True"}], ";", 
  RowBox[{"$HRFEx04RunObstructionSearchQ", "=", "True"}], ";", 
  RowBox[{"$HRFFindObstructionsStopOnFirstAdmissibleQ", "=", "False"}], ";", 
  RowBox[{"$HRFCandidateGeneratorSetLimit", "=", "64"}], ";", 
  RowBox[{"$HRFPolynomialMaxMonomials", "=", "12"}], ";", 
  RowBox[{"$HRFPolynomialRequireKinematicDomainQ", "=", "False"}], ";", 
  RowBox[{"Get", "[", 
   RowBox[{"FileNameJoin", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"NotebookDirectory", "[", "]"}], ",", 
      "\"\<HiddenRegionFinder.wl\>\""}], "}"}], "]"}], "]"}], ";", 
  RowBox[{"Get", "[", 
   RowBox[{"FileNameJoin", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"NotebookDirectory", "[", "]"}], ",", 
      "\"\<01_WideAngle_2to2_OffShell.wl\>\""}], "}"}], "]"}], "]"}], ";", 
  RowBox[{"Get", "[", 
   RowBox[{"FileNameJoin", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"NotebookDirectory", "[", "]"}], ",", 
      "\"\<HRF_PolynomialCancellationFactors.wl\>\""}], "}"}], "]"}], "]"}], 
  ";", 
  RowBox[{"hrfInstallPolynomialCancellationPatch", "[", "]"}], ";", 
  RowBox[{"Get", "[", 
   RowBox[{"FileNameJoin", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"NotebookDirectory", "[", "]"}], ",", 
      "\"\<04_PolynomialFactor_Regression.wl\>\""}], "}"}], "]"}], "]"}], 
  ";"}]], "Input",
 CellLabel->"In[1]:=",ExpressionUUID->"951489f3-d6c8-4cb5-8da5-880f894011ad"],

