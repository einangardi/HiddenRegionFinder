Cell["\<\
The full expressions are generated, not imported as unexplained symbols: \
makeFourPointOnShellF0 constructs U, F0 and F(delta) from the displayed edge \
lists and external attachments. The following association exposes every \
expression for direct inspection.\
\>", "Text",ExpressionUUID->"e8a3ebc3-127a-44a6-b7d6-10177b6ae526"],

Cell[BoxData[
 TagBox[
  RowBox[{"allPolynomials", "=", 
   RowBox[{"Association", "[", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"#ID", "\[Rule]", 
        RowBox[{"Association", "[", 
         RowBox[{
          RowBox[{"\"\<Variables\>\"", "\[Rule]", "#Vars"}], ",", 
          RowBox[{"\"\<U\>\"", "\[Rule]", "#U"}], ",", 
          RowBox[{"\"\<F0\>\"", "\[Rule]", "#F0"}], ",", 
          RowBox[{"\"\<F(delta)\>\"", "\[Rule]", 
           RowBox[{"#Data", "[", "\"\<FOnShell\>\"", "]"}]}]}], "]"}]}], 
       "&"}], ")"}], "/@", "records"}], "]"}]}],
  HoldForm]], "Input",ExpressionUUID->"34ebe2d5-07d8-4290-919f-e7ce572a91d1"],

Cell[BoxData[
 TagBox[
  RowBox[{
   RowBox[{"<<", "\"\<HRF_WideAngle16FacePinchRegressionTests.wl\>\""}], ";", 
   
   RowBox[{"hrfRunWA16FacePinchRegressionTests", "[", "]"}]}],
  HoldForm]], "Input",ExpressionUUID->"dd28e245-2464-4257-b3f3-30c6ab0a18b2"],

Cell[BoxData[
 TagBox[
  RowBox[{"RunProcess", "[", 
   RowBox[{"{", 
    RowBox[{"\"\<wolframscript\>\"", ",", "\"\<-file\>\"", 
     ",", "\"\<run_wa16_face_pinch_depth_batch.wl\>\"", ",", "\"\<min=4\>\"", 
     ",", "\"\<85774\>\""}], "}"}], "]"}],
  HoldForm]], "Input",ExpressionUUID->"7348db3a-f780-4981-a17a-c648e0d5c68d"],

Cell["\<\
Low-codimension inputs are results/wide_angle_16_current_audit_summary.wl, \
results/wide_angle_16_stored_boundaries_current_gap_summary.wl, \
results/wide_angle_16_codim3_hierarchy_gap_summary.wl and \
results/wide_angle_16_codim3_nearmiss_105233.wl. Higher-codimension primary \
files are HRF_WideAngle16FacePinchAudit.wl (certificate), \
run_wa16_face_pinch_depth_batch.wl (checkpointed exhaustive runner), \
aggregate_wa16_face_pinch_audit.wl (summary), and \
HRF_WideAngle16FacePinchRegressionTests.wl (Crown plus negative controls). \
cddexec is used only for exact Newton-face incidences.\
\>", "Text",ExpressionUUID->"68527f82-c977-43d0-8b70-4c8d5ca20bca"]
}, Closed]],

Cell[CellGroupData[{

Cell["10. References", "Section",ExpressionUUID->"b63bcb01-3f41-4342-8bc0-5644e6fc75f2"],

Cell["\<\
E. Gardi et al., arXiv:2407.13738, especially the discussion at the bottom of \
p. 19 (original no-Crown evidence and dissection framework).\
\>", "Text",ExpressionUUID->"f916af13-5c81-4427-ba9b-a3d443232a8b"],

Cell["\<\
E. Gardi et al., arXiv:2607.15126, Eqs. (13)\[Dash](17) (pinch, homogeneous \
F_SL, ideal presentation and strict hierarchy conditions).\
\>", "Text",ExpressionUUID->"fa77b768-4868-4536-960d-4ae68abdbf31"]
}, Closed]]
}, Open  ]]
},
