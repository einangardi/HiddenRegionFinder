 CellLabel->"In[17]:=",ExpressionUUID->"57d13c42-067f-4beb-b47a-dbe41ae9c0e9"],

Cell["Optional interiors", "Section",ExpressionUUID->"8cf3e38e-df92-4ede-9304-ae622a8dc12b"],

Cell["\<\
Run only when needed; HyperCrown interior is slow. These calls use the same \
current Regge path one diagram at a time.\
\>", "Text",ExpressionUUID->"66494ecb-226d-4f26-8567-c1f5e118575f"],

