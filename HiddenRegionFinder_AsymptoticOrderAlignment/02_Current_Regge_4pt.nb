  "]"}]], "Input",
 CellLabel->"In[5]:=",ExpressionUUID->"de0d53c6-7ce4-4cf6-8001-8b6fd2cd6bec"],

Cell[BoxData[
 RowBox[{"hrfEx02ShowDiagram", "[", 
  RowBox[{"DBInternalEdges", ",", "DBExternalEdges"}], "]"}]], "Input",
 CellLabel->"In[6]:=",ExpressionUUID->"cef55424-1a58-4ec2-bc92-a6eb2c6d0830"],

Cell["Crown interior positive control", "Section",ExpressionUUID->"502b60da-c895-4827-b59f-021a0daa69d9"],

Cell["\<\
Runs wide angle plus the three Regge channels for the Crown interior. This is \
the positive control for the Regge path.\
\>", "Text",ExpressionUUID->"54394233-6a1d-40f6-9bfa-ee62c9996853"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Ex02CrownInterior", "=", 
   RowBox[{"hrfEx02InteriorStudy", "[", 
    RowBox[{"\"\<Crown\>\"", ",", 
     RowBox[{"Ex02Diagrams", "[", "\"\<Crown\>\"", "]"}], ",", "20"}], 
    "]"}]}], ";", 
  RowBox[{"Dataset", "[", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"KeyTake", "[", 
       RowBox[{
        RowBox[{"Ex02CrownInterior", "[", "#1", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{
         "\"\<Kinematic regime\>\"", ",", "\"\<Hidden region identified?\>\"",
           ",", "\"\<Scaling status\>\"", ",", "\"\<Scaling vector\>\""}], 
         "}"}]}], "]"}], "&"}], ")"}], "/@", 
    RowBox[{"{", 
     RowBox[{
     "\"\<Wide\>\"", ",", "\"\<T23\>\"", ",", "\"\<T12\>\"", ",", 
      "\"\<T13\>\""}], "}"}]}], "]"}]}]], "Input",
 CellLabel->"In[7]:=",ExpressionUUID->"4659b86d-0a7d-4143-9442-ee86b3272972"],

Cell["SuperCrown boundary x8 = x9 = 0", "Section",ExpressionUUID->"e2fb526d-67eb-4452-9593-d377c5acbb5c"],

Cell["\<\
Expected current result: accepted hidden region in wide angle and in all \
three Regge channels.\
\>", "Text",ExpressionUUID->"3aaec196-aa40-4c00-878d-ef8058e15e23"],

Cell[BoxData[
 RowBox[{"hrfEx02RunSuperCrownBoundary", "[", "]"}]], "Input",
 CellLabel->"In[8]:=",ExpressionUUID->"efce64db-a24a-4c15-9c18-1bc4af00406b"],

Cell[BoxData[
 RowBox[{"InterpretationBox", "[", 
  RowBox[{
   RowBox[{"StyleBox", "[", 
    RowBox[{"\"\<Ex02SuperCrownReggeChannelSummary\>\"", ",", 
     RowBox[{"ShowStringCharacters", "\[Rule]", "True"}]}], "]"}], ",", 
   "Ex02SuperCrownReggeChannelSummary", ",", 
   RowBox[{"Editable", "\[Rule]", "False"}]}], "]"}]], "Input",
