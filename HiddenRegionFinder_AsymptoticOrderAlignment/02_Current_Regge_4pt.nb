 CellLabel->"In[15]:=",ExpressionUUID->"37bbc7bc-ab77-44df-a306-951342300233"],

Cell["Diving Beetle boundary x8 = x9 = 0", "Section",ExpressionUUID->"69f5db26-4858-479f-9512-f0e098065151"],

Cell["\<\
This is the current negative control in the tested Regge boundary stratum.\
\>", "Text",ExpressionUUID->"42cfc8fa-5da9-44db-b8aa-7a8d57196f3f"],

Cell[BoxData[
 RowBox[{"hrfEx02RunDBBoundary", "[", "]"}]], "Input",
 CellLabel->"In[16]:=",ExpressionUUID->"a3a7fce9-55d5-47c4-a015-ef434dd716eb"],

