Cell[BoxData[
 RowBox[{
  RowBox[{"hrfSCWideReport", "=", 
   RowBox[{"hrfEx02ReggeChannelDisplay", "[", 
    RowBox[{
    "\"\<SuperCrown\>\"", ",", "\"\<Boundary {x8,x9}\>\"", ",", 
     "\"\<Wide\>\""}], "]"}]}], ";", 
  RowBox[{"KeyTake", "[", 
   RowBox[{
    RowBox[{"hrfSCWideReport", "[", "\"\<Ingredients\>\"", "]"}], ",", 
    RowBox[{"{", 
     RowBox[{
     "\"\<Generators\>\"", ",", "\"\<ScalingVector\>\"", ",", 
      "\"\<VariableScaling\>\"", ",", "\"\<HiddenRegionQ\>\""}], "}"}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[11]:=",ExpressionUUID->"15546b42-a253-400e-a81e-3e5f21d751a8"],

Cell["HyperCrown boundary x11 = 0", "Section",ExpressionUUID->"bbf54851-3468-4fde-882e-e65cb0e97658"],

Cell["\<\
This is slower than SuperCrown. In the monitored split run, the accepted \
Regge boundary HR appeared in channel T12; wide angle is handled in notebook \
01.\
\>", "Text",ExpressionUUID->"70db3ef8-dee5-46ba-bc53-18689d4f343c"],

Cell[BoxData[
 RowBox[{"hrfEx02RunHyperCrownBoundary", "[", "]"}]], "Input",
 CellLabel->"In[12]:=",ExpressionUUID->"b6fd3124-66a7-4f0f-859a-d2ef282a5cdc"],

Cell[BoxData[
 RowBox[{"InterpretationBox", "[", 
  RowBox[{
