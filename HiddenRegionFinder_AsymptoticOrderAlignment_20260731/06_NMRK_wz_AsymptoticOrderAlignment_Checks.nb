               ImageMargins -> 0]}}, GridBoxAlignment -> 
             {"Columns" -> {{Left}}}, AutoDelete -> False, 
            GridBoxBackground -> {"Columns" -> {{Automatic}}}, 
            GridBoxItemSize -> {"Columns" -> {{Automatic}}, "Rows" -> {
                {Automatic}}}, GridBoxSpacings -> {"Columns" -> {{0.2}}, 
              "Rows" -> {{0.5}}}, BaselinePosition -> {1, 1}]}, 
         Dynamic[TrueQ[Typeset`var$$]], Alignment -> Automatic, 
         ImageSize -> Automatic, ImageMargins -> 0, BaseStyle -> {}, 
         DefaultBaseStyle -> "OpenerView", BaselinePosition -> Baseline], 
        Deployed -> False, StripOnInput -> False], 
       OpenerView[{"Certified NMRK LP layers", 
         Column[{Style["F_SL", Bold, RGBColor[2/3, 0, 0]], 
           Q X34h X56h (X34h X45 x5 + x4 (-X45) - x4) 
             (Kz x1 X45 X56h + x2 (-X45) - x2), Style["F at W_HR", Bold, 
            RGBColor[0, 0, 2/3]], 
           -Q X34h X45 X56h (Kz x0 x2 + Kz x0 x4 + Kz x1 x3 X56h + x3 X34h x5
              ), Style["U at W_HR", Bold, RGBColor[0, 0, 2/3]], x2 + x4}, 
          Spacings -> 1.1]}, False]], DynamicModuleValues -> Automatic], 
     Setting[#1, {0}] & ]], "Output"], Cell["Two-loop NMRK results", 
   "Section"], Cell["The exhaustive generic-NMRK scans have no staged \
candidate.  The w=z candidates have now been rerun through the current \
full-native-F audit: the aligned face proposes the cancellation and scaling, \
but every occupied eta layer of the original polynomial is then restored and \
tested under the composed vector.  Full-support and one-edge-boundary regions \
are counted separately.  This final audit retains seven planar-hexbox regions \
(four full support and three boundary); four additional staged candidates \
fail after the omitted layers are restored and are not counted as hidden \
regions.", "Text"], 
  Cell[BoxData[TagBox[GridBox[{{"\"Graph\"", "\"generic staged\"", 
        "\"w=z staged\"", "\"w=z certified\"", "\"full support\"", 
        "\"boundary strata\""}, {"\"planar-hexbox\"", "0", "13", "7", "4", 
        "3"}, {"\"nonplanar-hexbox\"", "0", "8", "3", "1", "2"}, 
       {"\"hexagon-pentagon\"", "0", "0", "0", "0", "0"}}, 
      GridBoxAlignment -> {"Columns" -> {{Left}}}, AutoDelete -> False, 
      GridBoxFrame -> {"Columns" -> {{True}}, "Rows" -> {{True}}}, 
      GridBoxItemSize -> {"Columns" -> {{Automatic}}, 
        "Rows" -> {{Automatic}}}], "Grid"]], "Output"], 
  Cell["Certified two-loop representatives", "Subsection"], 
  Cell["The panels are initially collapsed.  Vectors are associations on the \
active variables, so a boundary-stratum result cannot be mistaken for a \
