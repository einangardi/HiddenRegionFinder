Cell[CellGroupData[{

Cell["Exact equivalence with the earlier light-cone audit", "Subsection",ExpressionUUID->"0a2e819f-bd76-4ede-aa70-1236452f5b1d"],

Cell["\<\
The certified runs were originally expressed with finite coefficients \
P,K,M,R,T,C. They are exactly the same path under Q4hat2=R, X34hat=P/K, \
X45hat=K M/T, zetaHat zetaBarHat=R/T and zetaHat+zetaBarHat=sigma C/T. The \
physical domain P,M,K,R,T,C>0 and C^2<4 R T, with both transverse signs sigma \
checked, supplies an explicit positivity realization. This section is \
retained as an equivalence audit, not as a second definition of the limit.\
\>", "Text",ExpressionUUID->"16b578b6-6abf-45a3-9a51-e64b1a917cc6"],

Cell[BoxData[
 RowBox[{"hrf5MRKExactCentralSoftRules", "[", 
  RowBox[{"1", ",", "2", ",", "1"}], "]"}]], "Input",
 CellLabel->"In[1]:=",ExpressionUUID->"47d2977e-e1f0-464c-9a1e-426669c9eaa8"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"s12", "\[Rule]", 
    RowBox[{
     RowBox[{"C", " ", "delta"}], "+", 
     FractionBox[
      RowBox[{"K", " ", "M"}], "delta"], "+", 
     FractionBox[
      RowBox[{"M", " ", "P"}], 
      SuperscriptBox["delta", "4"]], "+", 
     RowBox[{"2", " ", 
      SuperscriptBox["delta", "2"], " ", "R"}], "+", 
     FractionBox[
      RowBox[{"C", " ", 
       SuperscriptBox["delta", "4"], " ", "R"}], 
      RowBox[{"K", " ", "M"}]], "+", 
     FractionBox[
      RowBox[{"P", " ", "R"}], 
      RowBox[{"delta", " ", "K"}]], "+", 
     FractionBox[
      RowBox[{
       SuperscriptBox["delta", "5"], " ", 
       SuperscriptBox["R", "2"]}], 
      RowBox[{"K", " ", "M"}]], "+", 
     RowBox[{"2", " ", "T"}], "+", 
     FractionBox[
      RowBox[{
       SuperscriptBox["delta", "3"], " ", "K", " ", "T"}], "P"], "+", 
     FractionBox[
      RowBox[{"C", " ", 
       SuperscriptBox["delta", "5"], " ", "T"}], 
      RowBox[{"M", " ", "P"}]], "+", 
     FractionBox[
      RowBox[{
       SuperscriptBox["delta", "3"], " ", "R", " ", "T"}], 
      RowBox[{"K", " ", "M"}]], "+", 
     FractionBox[
      RowBox[{
       SuperscriptBox["delta", "6"], " ", "R", " ", "T"}], 
      RowBox[{"M", " ", "P"}]], "+", 
     FractionBox[
      RowBox[{
       SuperscriptBox["delta", "4"], " ", 
       SuperscriptBox["T", "2"]}], 
      RowBox[{"M", " ", "P"}]]}]}], ",", 
   RowBox[{"s23", "\[Rule]", 
    RowBox[{
     RowBox[{"-", "T"}], "-", 
     FractionBox[
      RowBox[{
       SuperscriptBox["delta", "3"], " ", "K", " ", "T"}], "P"], "-", 
     FractionBox[
      RowBox[{"C", " ", 
       SuperscriptBox["delta", "5"], " ", "T"}], 
      RowBox[{"M", " ", "P"}]], "-", 
     FractionBox[
      RowBox[{
       SuperscriptBox["delta", "6"], " ", "R", " ", "T"}], 
      RowBox[{"M", " ", "P"}]], "-", 
     FractionBox[
      RowBox[{
       SuperscriptBox["delta", "4"], " ", 
       SuperscriptBox["T", "2"]}], 
      RowBox[{"M", " ", "P"}]]}]}], ",", 
   RowBox[{"s34", "\[Rule]", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "C"}], " ", "delta"}], "+", 
     FractionBox[
      RowBox[{"P", " ", "R"}], 
      RowBox[{"delta", " ", "K"}]], "+", 
     FractionBox[
      RowBox[{
       SuperscriptBox["delta", "3"], " ", "K", " ", "T"}], "P"]}]}], ",", 
   RowBox[{"s45", "\[Rule]", 
    RowBox[{
     RowBox[{"C", " ", "delta"}], "+", 
     FractionBox[
      RowBox[{"K", " ", "M"}], "delta"], "+", 
     RowBox[{"2", " ", 
      SuperscriptBox["delta", "2"], " ", "R"}], "+", 
     FractionBox[
      RowBox[{"C", " ", 
       SuperscriptBox["delta", "4"], " ", "R"}], 
      RowBox[{"K", " ", "M"}]], "+", 
     FractionBox[
      RowBox[{
       SuperscriptBox["delta", "5"], " ", 
       SuperscriptBox["R", "2"]}], 
      RowBox[{"K", " ", "M"}]], "+", 
     FractionBox[
      RowBox[{
       SuperscriptBox["delta", "3"], " ", "R", " ", "T"}], 
      RowBox[{"K", " ", "M"}]]}]}], ",", 
   RowBox[{"s15", "\[Rule]", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "C"}], " ", "delta"}], "-", 
     RowBox[{
      SuperscriptBox["delta", "2"], " ", "R"}], "-", 
     FractionBox[
      RowBox[{"C", " ", 
       SuperscriptBox["delta", "4"], " ", "R"}], 
      RowBox[{"K", " ", "M"}]], "-", 
     FractionBox[
      RowBox[{
       SuperscriptBox["delta", "5"], " ", 
       SuperscriptBox["R", "2"]}], 
      RowBox[{"K", " ", "M"}]], "-", "T", "-", 
     FractionBox[
      RowBox[{"C", " ", 
       SuperscriptBox["delta", "5"], " ", "T"}], 
      RowBox[{"M", " ", "P"}]], "-", 
     FractionBox[
      RowBox[{
       SuperscriptBox["delta", "3"], " ", "R", " ", "T"}], 
      RowBox[{"K", " ", "M"}]], "-", 
     FractionBox[
      RowBox[{
       SuperscriptBox["delta", "6"], " ", "R", " ", "T"}], 
      RowBox[{"M", " ", "P"}]], "-", 
     FractionBox[
      RowBox[{
       SuperscriptBox["delta", "4"], " ", 
       SuperscriptBox["T", "2"]}], 
      RowBox[{"M", " ", "P"}]]}]}]}], "}"}]], "Output",
 CellLabel->"Out[1]=",ExpressionUUID->"2b21c3cc-18c8-4b5a-ba42-77f1ae3d3cbd"],

Cell[BoxData[
 TagBox[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Q4hat2", "\[LongEqual]", "R"}], ",", 
     RowBox[{"X34hat", "\[LongEqual]", 
      FractionBox["P", "K"]}], ",", 
     RowBox[{"X45hat", "\[LongEqual]", 
      FractionBox[
       RowBox[{"K", " ", "M"}], "T"]}], ",", 
     RowBox[{
      RowBox[{"zetaBarHat", " ", "zetaHat"}], "\[LongEqual]", 
      FractionBox["R", "T"]}], ",", 
     RowBox[{
      RowBox[{"zetaBarHat", "+", "zetaHat"}], "\[LongEqual]", 
      FractionBox[
       RowBox[{"C", " ", "sigma"}], "T"]}]}], "}"}],
   TraditionalForm],
  TraditionalForm,
  Editable->True]], "Output",ExpressionUUID->"c280aada-9c13-4eea-8f61-\
3b7a6d1f8c59"]
}, Closed]],

Cell["3. Graphs and edge variables", "Section",ExpressionUUID->"86febdc9-3759-4ed1-bd3f-e308732995fd"],

Cell["\<\
Every diagram is drawn in the same physical scattering frame: p2 and p1 enter \
from the upper- and lower-left; p3, p4 and p5 emerge on the right in \
decreasing rapidity order. The internal vertices remain fixed in the \
canonical geometry of the spacelike-collinear seed; crossed external lines \
are crossings, not vertices. The first two diagrams are negative controls. \
The last two have the same internal two-loop topology but different external \
attachment labelings: moving the central emission p4 from vertex 4 to the \
four-valent vertex 5 changes the result from no HR to HR. Edge parameters \
x0,x1,... follow the order of InternalLines printed below.\
\>", "Text",ExpressionUUID->"f2b603b4-daea-4c50-994e-d273d91320f8"],

