Cell["SuperCrown codimension-two boundary HR", "Section",ExpressionUUID->"407dec09-915b-42d7-90a1-f5c7609ea733"],

Cell["\<\
This focused constructive check restores the SuperCrown example without \
attempting a full boundary survey. It is an ordinary wide-angle HRF run: no \
asymptotic-order alignment is performed. On B={x8=0,x9=0}, HRF starts from \
the native restricted F0, finds the two Crown generators, constructs FSL with \
zero obstruction, and only then solves for one exact region vector. Here FSL \
is the Crown superleading polynomial multiplied by x10 x11. Boundary \
equations x_e=0 and scaling components v_e are reported separately.\
\>", "Text",ExpressionUUID->"610fccc3-9aa9-4326-84aa-a4764a2aaaa1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Ex04SuperCrownX89Target", "=", 
   RowBox[{"hrfEx04SuperCrownX89Boundary", "[", "]"}]}], ";", 
  RowBox[{"hrfSCIngredients", "=", 
   RowBox[{"hrfEx04CaseIngredients", "[", "Ex04SuperCrownX89Target", "]"}]}], 
  ";", 
  RowBox[{"Association", "[", 
   RowBox[{
    RowBox[{"\"\<Boundary B\>\"", "\[Rule]", 
     RowBox[{
     "hrfSCIngredients", "[", "\"\<BoundaryZeroVariables\>\"", "]"}]}], ",", 
    RowBox[{"\"\<Active edge order\>\"", "\[Rule]", 
     RowBox[{"hrfSCIngredients", "[", "\"\<RegionVariables\>\"", "]"}]}], ",", 
    RowBox[{"\"\<v_B=(v_e;1)\>\"", "\[Rule]", 
     RowBox[{"Append", "[", 
      RowBox[{
       RowBox[{"hrfSCIngredients", "[", "\"\<ScalingVector\>\"", "]"}], ",", 
       "1"}], "]"}]}], ",", 
    RowBox[{"\"\<Named components\>\"", "\[Rule]", 
     RowBox[{"Normal", "[", 
      RowBox[{"hrfSCIngredients", "[", "\"\<VariableScaling\>\"", "]"}], 
      "]"}]}], ",", 
    RowBox[{"\"\<Hidden region\>\"", "\[Rule]", 
     RowBox[{"hrfSCIngredients", "[", "\"\<HiddenRegionQ\>\"", "]"}]}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[7a]:=",ExpressionUUID->"f2d96be6-41ea-4edc-a91e-fe099ac1fc02"],

Cell[BoxData[
 RowBox[{"KeyTake", "[", 
  RowBox[{"hrfSCIngredients", ",", 
   RowBox[{"{", 
    RowBox[{"\"\<Generators\>\"", ",", "\"\<FSL\>\"", 
     ",", "\"\<Obstruction\>\"", ",", "\"\<ScalingStatus\>\""}], "}"}]}], 
