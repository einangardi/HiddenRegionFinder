 RowBox[{
  RowBox[{"Ex04DivingBeetleInterior", "=", 
   RowBox[{"hrfEx04DivingBeetleInterior", "[", "]"}]}], ";", 
  RowBox[{"hrfDBInteriorReport", "=", 
   RowBox[{"hrfEx04DivingBeetleInteriorDisplay", "[", "]"}]}], ";", 
  RowBox[{"hrfDBInteriorReport", "[", "\"\<Summary\>\"", "]"}]}]], "Input",
 CellLabel->"In[17]:=",ExpressionUUID->"5b891b7d-0d1a-41de-a90b-6ff0fd2dd02c"],

Cell[BoxData[
 RowBox[{
