                      UndirectedEdge[2, 4] -> Directive[GrayLevel[0.3],
                        AbsoluteThickness[1.5]], UndirectedEdge[2, p2] ->
                       Directive[GrayLevel[0.5], Dashing[{Small, Small}]],
                      UndirectedEdge[1, 4] -> Directive[GrayLevel[0.3],
                        AbsoluteThickness[1.5]], UndirectedEdge[1, 5] ->
                       Directive[GrayLevel[0.3], AbsoluteThickness[1.5]],
                      UndirectedEdge[2, 6] -> Directive[GrayLevel[0.3],
