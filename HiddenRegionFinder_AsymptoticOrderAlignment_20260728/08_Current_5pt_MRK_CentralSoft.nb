Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"TotalGraphEdgeVector\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", "4"}], ",", 
      RowBox[{"-", "4"}], ",", 
      RowBox[{"-", "1"}], ",", 
      RowBox[{"-", "4"}], ",", 
      RowBox[{"-", "4"}], ",", 
      RowBox[{"-", "4"}]}], "}"}]}], ",", 
   RowBox[{"\<\"RawSuperleadingFPower\"\>", "\[Rule]", 
    RowBox[{"-", "13"}]}], ",", 
   RowBox[{"\<\"ScalefulLPWeight\"\>", "\[Rule]", 
    RowBox[{"-", "8"}]}], ",", 
   RowBox[{"\<\"AlignmentDepth\"\>", "\[Rule]", "4"}], ",", 
   RowBox[{"\<\"FinalHRFGap\"\>", "\[Rule]", "1"}], ",", 
   RowBox[{"\<\"TotalCancellationDepth\"\>", "\[Rule]", "5"}], ",", 
   RowBox[{"\<\"PropagatorVirtualityPowers\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"4", ",", "4", ",", "1", ",", "4", ",", "4", ",", "4"}], "}"}]}],
    ",", 
   RowBox[{"\<\"GlauberCentralValue\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"2", ",", "2", ",", "0"}], "}"}]}], ",", 
   RowBox[{"\<\"GlauberLocalFluctuationWidths\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"6", ",", "3", ",", "2"}], "}"}]}], ",", 
   RowBox[{"\<\"OtherLoopLocalFluctuationWidths\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"6", ",", 
      RowBox[{"-", "2"}], ",", "2"}], "}"}]}], ",", 
   RowBox[{"\<\"LeadingEllPlusPinchEdges\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"x4", ",", "x5"}], "}"}]}], ",", 
   RowBox[{"\<\"EllPlusPoleSeparationPower\"\>", "\[Rule]", "6"}], ",", 
   RowBox[{"\<\"PowerAtD4Minus2Eps\"\>", "\[Rule]", 
    RowBox[{
     RowBox[{"-", "8"}], " ", "eps"}]}], ",", 
   RowBox[{"\<\"MomentumPowerCertifiedQ\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"MomentumPowerStatus\"\>", 
    "\[Rule]", "\<\"Certified by the q4/q5 ell-plus pole pinch\"\>"}]}], 
