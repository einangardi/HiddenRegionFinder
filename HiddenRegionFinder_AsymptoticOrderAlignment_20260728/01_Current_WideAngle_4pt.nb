 RowBox[{
  RowBox[{"CrownMomentumCertificate", "=", 
   RowBox[{"hrfWideAngleCrownMomentumCertificate", "[", "]"}]}], ";", 
  RowBox[{
  "hrfWideAngleMomentumCertificateSummary", "[", "CrownMomentumCertificate", 
   "]"}]}]], "Input",
 CellLabel->"In[11]:=",ExpressionUUID->"98918f14-e4dd-4737-9b21-9a1f529d1b17"],

