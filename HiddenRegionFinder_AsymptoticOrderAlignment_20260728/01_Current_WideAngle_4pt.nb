     "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[13]:=",ExpressionUUID->"dad64cea-b658-4520-994e-c71f6e678c97"],

Cell["HyperCrown boundary x11=0: Landshoff plus a soft loop", "Subsection",ExpressionUUID->"073abfd4-12e8-4db0-8ba8-69aadc90f199"],

Cell["\<\
The parametric boundary x11=0 contracts the x11 edge and merges its endpoints \
before momentum conservation is imposed. The ten jet propagators have \
q_e^2~delta, whereas x10 has q10~(delta,delta,delta) and q10^2~delta^2. A \
valid four-loop basis is {x0,x4,x6,x10}: three external-direction jet momenta \
plus the soft exchange. Thus the boundary region is a Landshoff descendant \
with an extra soft loop, not a new generic-angle Glauber mode.\
\>", "Text",ExpressionUUID->"aa5677a7-94ca-483e-9d18-ce1a9a3d98c1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"HyperCrownX11MomentumCertificate", "=", 
   RowBox[{"hrfWideAngleHyperCrownX11MomentumCertificate", "[", "]"}]}], ";", 
  
  RowBox[{
  "hrfWideAngleMomentumCertificateSummary", "[", 
   "HyperCrownX11MomentumCertificate", "]"}]}]], "Input",
 CellLabel->"In[14]:=",ExpressionUUID->"15c09625-1f8b-48a0-99f0-e1cfdc5e50e6"],

Cell[BoxData[
 RowBox[{"HyperCrownX11MomentumCertificate", "[", "\"\<MomentumTable\>\"", 
  "]"}]], "Input",
 CellLabel->"In[15]:=",ExpressionUUID->"8afecd21-4f5f-4b3a-abbb-389e1e6ab010"],

Cell[BoxData[
 RowBox[{"Association", "[", 
  RowBox[{
   RowBox[{"\"\<BoundaryContraction\>\"", "\[Rule]", 
    RowBox[{
    "HyperCrownX11MomentumCertificate", "[", "\"\<BoundaryContraction\>\"", 
     "]"}]}], ",", 
   RowBox[{"\"\<MomentumRelations\>\"", "\[Rule]", 
    RowBox[{
    "HyperCrownX11MomentumCertificate", "[", "\"\<MomentumRelations\>\"", 
     "]"}]}], ",", 
   RowBox[{"\"\<VertexConservationCompatibleQ\>\"", "\[Rule]", 
    RowBox[{"HyperCrownX11MomentumCertificate", "[", 
     RowBox[{"\"\<VertexAudit\>\"", 
      ",", "\"\<AllVertexComponentsCompatibleQ\>\""}], "]"}]}], ",", 
   RowBox[{"\"\<IndependentLoopBasisValidQ\>\"", "\[Rule]", 
    RowBox[{
    "HyperCrownX11MomentumCertificate", 
     "[", "\"\<IndependentLoopBasisValidQ\>\"", "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[16]:=",ExpressionUUID->"889762a4-295c-4d4c-a9f8-a80f96149ffe"],

Cell["All positive HyperCrown strata", "Subsection",ExpressionUUID->"2c6ab7cd-8592-457c-89a9-686f73f63229"],

Cell["\<\
The four codimension-one regions are symmetry-related Landshoff descendants \
with one soft loop: contracting x8, x9, x10 or x11 makes the opposite square \
edge x9, x8, x11 or x10 soft, respectively. The four positive adjacent-pair \
codimension-two regions have uniform v_e=-1 on every active parameter. Their \
extra parallel pair is collinear to p1, p2, p3 or p4 according to the \
stratum; no propagator or loop requires Glauber scaling.\
\>", "Text",ExpressionUUID->"2eecb2ad-f704-4f91-90fd-8daef9425bf1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"HyperCrownPositiveMomentumCertificates", "=", 
   RowBox[{"hrfWideAngleHyperCrownPositiveMomentumCertificates", "[", "]"}]}],
   ";", 
  RowBox[{"Dataset", "[", 
   RowBox[{"KeyValueMap", "[", 
    RowBox[{
     RowBox[{"Function", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"stratum", ",", "cert"}], "}"}], ",", 
       RowBox[{"Association", "[", 
        RowBox[{
         RowBox[{"\"\<Boundary B\>\"", "\[Rule]", "stratum"}], ",", 
         RowBox[{"\"\<v_B (active order;1)\>\"", "\[Rule]", 
          RowBox[{"ToString", "[", 
           InterpretationBox[
            StyleBox[
             RowBox[{"cert", "[", "\"\<ScalingVectorWithDelta\>\"", "]"}],
             ShowStringCharacters->True,
             NumberMarks->True],
            InputForm[
             $CellContext`cert["ScalingVectorWithDelta"]],
            AutoDelete->True,
            Editable->True], "]"}]}], ",", 
         RowBox[{"\"\<Virtualities\>\"", "\[Rule]", 
          RowBox[{"ToString", "[", 
           InterpretationBox[
            StyleBox[
             RowBox[{"Normal", "[", 
              RowBox[{"cert", "[", "\"\<VirtualityPowers\>\"", "]"}], "]"}],
             ShowStringCharacters->True,
             NumberMarks->True],
            InputForm[
             Normal[
              $CellContext`cert["VirtualityPowers"]]],
            AutoDelete->True,
            Editable->True], "]"}]}], ",", 
         RowBox[{"\"\<Vertex conservation\>\"", "\[Rule]", 
          RowBox[{"cert", "[", 
           
           RowBox[{"\"\<VertexAudit\>\"", 
            ",", "\"\<AllVertexComponentsCompatibleQ\>\""}], "]"}]}], ",", 
         RowBox[{"\"\<Loop basis valid\>\"", "\[Rule]", 
          RowBox[{"cert", "[", "\"\<IndependentLoopBasisValidQ\>\"", "]"}]}], 
         ",", 
         RowBox[{"\"\<Interpretation\>\"", "\[Rule]", 
          RowBox[{"cert", "[", "\"\<Interpretation\>\"", "]"}]}]}], "]"}]}], 
      "]"}], ",", "HyperCrownPositiveMomentumCertificates"}], "]"}], 
   "]"}]}]], "Input",
 CellLabel->
  "In[16a]:=",ExpressionUUID->"115d01a0-0555-4ce5-a8ae-87680d3812d5"],

Cell["\<\
Select any established stratum to inspect the complete edge-by-edge \
(+,-,perp) table. The example below is the uniform x8=x10=0 region; available \
keys are {x8}, {x9}, {x10}, {x11}, {x8,x10}, {x8,x11}, {x9,x10} and {x9,x11}.\
\
\>", "Text",ExpressionUUID->"d6373868-4be4-46f2-bb0e-f2fabaf7d89d"],

Cell[BoxData[
 RowBox[{
  RowBox[{
  "HyperCrownPositiveMomentumCertificates", "[", "\"\<{x8, x10}\>\"", "]"}], 
  "[", "\"\<MomentumTable\>\"", "]"}]], "Input",
 CellLabel->
  "In[16b]:=",ExpressionUUID->"327a30ce-af9d-44fe-bc09-7f1944c15a65"],

Cell["Diving Beetle checks", "Section",ExpressionUUID->"a8325639-8dc2-48ff-97d3-7433e5b11b96"],

Cell["\<\
These cells are the current direct HRF checks for Diving Beetle. They are \
expected to produce no accepted hidden region in the tested interior and \
x8,x9 boundary cases.\
\>", "Text",ExpressionUUID->"0e09b5ef-4fc0-45dc-ba39-71c2832ce927"],

