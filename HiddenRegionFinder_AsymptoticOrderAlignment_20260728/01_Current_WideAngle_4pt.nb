 RowBox[{"Association", "[", 
  RowBox[{
   RowBox[{"\"\<MomentumRelations\>\"", "\[Rule]", 
    RowBox[{
    "CrownMomentumCertificate", "[", "\"\<MomentumRelations\>\"", "]"}]}], ",", 
