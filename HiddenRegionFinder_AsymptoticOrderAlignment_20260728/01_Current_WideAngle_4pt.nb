  RowBox[{"hrfSCIngredients", "=", 
   RowBox[{"hrfEx04CaseIngredients", "[", "Ex04SuperCrownX89Target", "]"}]}], 
  ";", 
  RowBox[{"Association", "[", 
   RowBox[{
    RowBox[{"\"\<Boundary B\>\"", "\[Rule]", 
     RowBox[{
     "hrfSCIngredients", "[", "\"\<BoundaryZeroVariables\>\"", "]"}]}], ",", 
    RowBox[{"\"\<Active edge order\>\"", "\[Rule]", 
