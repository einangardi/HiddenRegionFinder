Notebook[{
Cell["Two-loop NMRK Part-II and source-aware dissection audit", "Title",ExpressionUUID->"8fb57b28-d4ca-4fc2-bff6-39666a73171f"],

Cell["\<\
separate-path hexagon--pentagon (legacy key hexagon-pentagon) at w=z\
\>", "Subtitle",ExpressionUUID->"37ac7c56-bceb-47de-9068-9728184e55a6"],

Cell["\<\
Purpose. This evaluated notebook applies the current source-aware dissection \
to all 0 staged candidates for the separate-path hexagon--pentagon (legacy \
key hexagon-pentagon) and tests whether they are rejected, rescued or \
identified with one another. It does not assume that the old staged status is \
final.\
\>", "Text",ExpressionUUID->"5fb9e39c-a2b0-4dce-8c96-9e75432e088b"],

Cell["1. What the current dissection does", "Section",ExpressionUUID->"90e76d52-d5aa-4729-8c6a-174a6889fa5f"],

Cell["\<\
The current implementation is HRF_SourceAwareDissectionCertification.wl. It \
preserves four sources separately: F_SL, F_Obs, every remaining native F \
layer and U. It maps each independent cancellation factor to signed endpoint \
coordinates, enumerates all pivot choices and sign sectors, recombines equal \
local exponent rows exactly, and sends the resulting rational Newton support \
to cddlib. An accepted certificate must have a positive eta-oriented exact \
lower facet of full affine rank, positive suppression transverse to every \
cancellation factor, a nonzero inverse-chart Jacobian, an exact pullback to \
the original LP variables and W_HR>W_SL. No copy of F_SL is promoted to W_HR \
by hand.\
\>", "Text",ExpressionUUID->"711c242c-bb3f-4592-ba40-be14854797f1"],

Cell["\<\
This is a certification step for a full-rank Part-II solution, but it is also \
a completion step when the original-variable weight system is rank deficient: \
the local facet can select a different pullback scaling. A zero gap rejects \
only the provisional scaling being tested unless the Part-II active-set \
search is exhaustive.\
\>", "Text",ExpressionUUID->"07054b36-48e1-4a08-91de-ab46a344a8db"],

Cell["2. Exact code and saved candidate input", "Section",ExpressionUUID->"7cd776cb-a42b-4837-a77b-87ce1961102b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"$HRFQuietReports", "=", "True"}], ";", 
  RowBox[{"Get", "[", 
   RowBox[{"FileNameJoin", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"NotebookDirectory", "[", "]"}], 
      ",", "\"\<HiddenRegionFinder.wl\>\""}], "}"}], "]"}], "]"}], ";", 
  RowBox[{"Get", "[", 
   RowBox[{"FileNameJoin", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"NotebookDirectory", "[", "]"}], 
      ",", "\"\<HRF_AsymptoticOrderAlignment.wl\>\""}], "}"}], "]"}], "]"}], ";", 
  RowBox[{"savedScan", "=", 
   RowBox[{"Import", "[", 
    RowBox[{
     RowBox[{"FileNameJoin", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"NotebookDirectory", "[", "]"}], ",", "\"\<results\>\"", 
        ",", "\"\<nmrk_wz\>\"", ",", "\"\<full_wz_hexagon-pentagon.wl\>\""}], 
       "}"}], "]"}], ",", "\"\<WL\>\""}], "]"}]}], ";", 
  RowBox[{"candidateRows", "=", 
   RowBox[{
   "savedScan", "[", "\"\<StagedDeduplicatedHiddenRegionRows\>\"", "]"}]}], ";", 
  RowBox[{"Length", "[", "candidateRows", "]"}]}]], "Input",
 CellLabel->"In[1]:=",ExpressionUUID->"c7ee25b6-18b5-4b79-9b99-9937dfa37d46"],

Cell[BoxData["0"], "Output",ExpressionUUID->"63971b73-fe5f-4b54-85b6-15495bd41f90"],

Cell["\<\
The graph incidence data, U polynomial, w=z coefficient transform, enlarged \
exhaustive caps and the complete evaluation loop are defined in \
rebuild_two_loop_nmrk_partII_dissection_audit_notebook.wl. The operative call \
is shown next.\
\>", "Text",ExpressionUUID->"3090cf49-8e0c-4578-a9f3-573fd78c8296"],

Cell[BoxData[
 RowBox[{
  RowBox[{"candidateAudits", "=", 
   RowBox[{"MapIndexed", "[", 
    RowBox[{
     RowBox[{"Function", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"row", ",", "index"}], "}"}], ",", 
       RowBox[{
        RowBox[{"audit", "=", 
         RowBox[{"hrfSourceAwareAlignedDissectionCertificate", "[", 
          RowBox[{
          "row", ",", "termData", ",", "masterVariables", ",", "graphU", ",", 
           "etaSymbol", ",", "hrfPartIIWZTransform", ",", 
           RowBox[{"Sequence", "@@", "dissectionOptions"}]}], "]"}]}], ";", 
        RowBox[{"Association", "[", 
         RowBox[{
          RowBox[{"\"\<Candidate\>\"", "\[Rule]", 
           RowBox[{"First", "[", "index", "]"}]}], ",", 
          RowBox[{"\"\<Audit\>\"", "\[Rule]", "audit"}]}], "]"}]}]}], "]"}], ",",
      "candidateRows"}], "]"}]}], ";", 
  RowBox[{"KeyTake", "[", 
   RowBox[{"auditSummary", ",", 
    RowBox[{"{", 
     RowBox[{"\"\<StagedCandidateCount\>\"", 
      ",", "\"\<CandidatesWithAtLeastOneCertificate\>\"", 
      ",", "\"\<AllCandidateSearchesCompleteQ\>\"", 
      ",", "\"\<AllCertificatesScalefulQ\>\""}], "}"}]}], "]"}]}]], "Input",
 CellLabel->"In[2]:=",ExpressionUUID->"9ce9c7e5-aa9f-4f68-86a5-2bc39a8c9392"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"StagedCandidateCount\"\>", "\[Rule]", "0"}], ",", 
   RowBox[{"\<\"CandidatesWithAtLeastOneCertificate\"\>", "\[Rule]", "0"}], ",", 
   RowBox[{"\<\"AllCandidateSearchesCompleteQ\"\>", "\[Rule]", "True"}], ",", 
   
   RowBox[{"\<\"AllCertificatesScalefulQ\"\>", "\[Rule]", "True"}]}], 
  "\[RightAssociation]"}]], "Output",ExpressionUUID->"e61216eb-624c-4ebf-b062-\
097b7d6d73d1"],

Cell["3. The 0 staged candidates", "Section",ExpressionUUID->"5ae06fc2-c045-4973-8481-70e3e0e72f0e"],

Cell["\<\
The old status and rank columns are diagnostics inherited from the previous \
audit. They are displayed for comparison and are not used to decide the \
modern result. The last three columns come from the exact source-aware \
dissection.\
\>", "Text",ExpressionUUID->"f036b57a-d3dc-47a0-bb19-bc49f6daf10e"],

