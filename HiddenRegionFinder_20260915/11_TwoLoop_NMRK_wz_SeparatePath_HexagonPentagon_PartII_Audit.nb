 TagBox[GridBox[{
    {"\<\"candidate\"\>", "\<\"boundary\"\>", "\<\"alignment face\"\>", \
"\<\"cancellation factors\"\>", "\<\"old provisional status\"\>", "\<\"old \
rank/required\"\>", "\<\"old gap\"\>", "\<\"positive-pinch obstruction\"\>", \
"\<\"exact local facets\"\>", "\<\"search complete\"\>", "\<\"scaleful\"\>"}
   },
