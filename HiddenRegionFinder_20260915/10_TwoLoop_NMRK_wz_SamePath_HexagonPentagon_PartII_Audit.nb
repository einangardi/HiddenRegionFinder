Cell["5. Exact duplicate audit", "Section",ExpressionUUID->"8421ef45-b759-4c83-b412-5742afbd3da5"],

Cell["\<\
A raw local-facet certificate is not automatically a distinct HR. The \
physical grouping merges outputs with the same boundary stratum, normalised \
pullback scaling, W_HR and cancellation ideal, the latter tested by exact \
Groebner bases in the active LP variables. W_SL and the associated \
cancellation depth are retained as presentation diagnostics but do not split \
an HR.\
\>", "Text",ExpressionUUID->"d39703fb-cfe8-4d74-8f34-c9aa6369e440"],

Cell[BoxData[
 RowBox[{
  RowBox[{"vectorGroups", "=", 
   RowBox[{"GatherBy", "[", 
    RowBox[{"certificateRecords", ",", "hrfPartIIVectorKey"}], "]"}]}], ";", 
  RowBox[{"physicalHRGroups", "=", 
   RowBox[{"GatherBy", "[", 
    RowBox[{"certificateRecords", ",", "hrfPartIIHRKey"}], "]"}]}], ";", 
  RowBox[{"regionGroups", "=", 
   RowBox[{"GatherBy", "[", 
    RowBox[{"certificateRecords", ",", "hrfPartIIRegionKey"}], "]"}]}], ";", 
  RowBox[{"KeyTake", "[", 
   RowBox[{"auditSummary", ",", 
    RowBox[{"{", 
     RowBox[{"\"\<RawCertificateCount\>\"", 
      ",", "\"\<DistinctPullbackVectorCount\>\"", 
      ",", "\"\<DistinctPhysicalHRCount\>\"", 
      ",", "\"\<InteriorPhysicalHRCount\>\"", 
      ",", "\"\<CodimensionOnePhysicalHRCount\>\"", 
      ",", "\"\<StrictCertificatePresentationCount\>\"", 
      ",", "\"\<CountAgreesWithPreviousTableQ\>\""}], "}"}]}], 
   "]"}]}]], "Input",
