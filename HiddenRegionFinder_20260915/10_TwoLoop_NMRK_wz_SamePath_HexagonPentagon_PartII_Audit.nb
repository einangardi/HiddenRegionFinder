   RowBox[{"\<\"AllCandidateSearchesCompleteQ\"\>", "\[Rule]", "True"}], ",", 
   
   RowBox[{"\<\"AllCertificatesScalefulQ\"\>", "\[Rule]", "True"}]}], 
  "\[RightAssociation]"}]], "Output",ExpressionUUID->"6a41a281-45e5-48af-9fc1-\
51f49c1b456c"],

Cell["3. The 8 staged candidates", "Section",ExpressionUUID->"77512116-4e3d-4790-89c5-c64910561d22"],

