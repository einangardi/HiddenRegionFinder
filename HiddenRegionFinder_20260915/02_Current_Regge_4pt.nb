Notebook[{

Cell[CellGroupData[{
Cell["Current Regge-limit 4-point examples", "Title",ExpressionUUID->"91b33123-c757-4850-a8fb-6daec3974e28"],

Cell["\<\
Current Regge path only: explicit boundary/interior runners and Regge delta \
layers in scaling acceptance.\
\>", "Text",ExpressionUUID->"2400c0e3-f9f5-4b59-ad64-8e66db6ee1e1"],

Cell["Setup", "Section",ExpressionUUID->"f634cb32-61cc-4a4c-a008-a7b482374569"],

Cell["\<\
This notebook runs the current Regge path. Boundaries are explicit calls so \
each block can be run in a fresh kernel if memory is tight.\
\>", "Text",ExpressionUUID->"3ff6ed27-51e2-463f-a062-6b7532e735bb"],

Cell[BoxData[
 RowBox[{
  RowBox[{"$HRFExample02Report", "=", "True"}], ";", 
  RowBox[{"$HRFScalingReport", "=", "False"}], ";", 
  RowBox[{"$HRFRunEx02InteriorStudiesOnLoad", "=", "False"}], ";", 
  RowBox[{"$HRFRunEx02LegacyCrownForwardOnLoad", "=", "False"}], ";", 
  RowBox[{"$HRFRunEx02BoundariesOnLoad", "=", "False"}], ";", 
  RowBox[{"$HRFRunEx02SuperCrownBoundary", "=", "False"}], ";", 
  RowBox[{"$HRFRunEx02HyperCrownBoundaries", "=", "False"}], ";", 
  RowBox[{"$HRFRunEx02DBBoundary", "=", "False"}], ";", 
  RowBox[{"$HRFRunEx02CrownSanityOnLoad", "=", "False"}], ";", 
  RowBox[{"$HRFEx02TrimScanStorageQ", "=", "True"}], ";", 
  RowBox[{"$HRFEx02DeepTrimScanStorageQ", "=", "True"}], ";", 
  RowBox[{"$HRFFindObstructionsStopOnFirstAdmissibleQ", "=", "False"}], ";", 
  RowBox[{"$HRFCandidateGeneratorSetLimit", "=", "64"}], ";", 
  RowBox[{"$HRFPolynomialMaxMonomials", "=", "12"}], ";", 
  RowBox[{"$HRFPolynomialRequireKinematicDomainQ", "=", "False"}], ";", 
  RowBox[{"Get", "[", 
   RowBox[{"FileNameJoin", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"NotebookDirectory", "[", "]"}], 
      ",", "\"\<HiddenRegionFinder.wl\>\""}], "}"}], "]"}], "]"}], ";", 
  RowBox[{"Get", "[", 
   RowBox[{"FileNameJoin", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"NotebookDirectory", "[", "]"}], 
      ",", "\"\<HRF_PolynomialCancellationFactors.wl\>\""}], "}"}], "]"}], 
   "]"}], ";", 
  RowBox[{"hrfInstallPolynomialCancellationPatch", "[", "]"}], ";", 
  RowBox[{"Get", "[", 
   RowBox[{"FileNameJoin", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"NotebookDirectory", "[", "]"}], 
      ",", "\"\<02_Forward_Regge_2to2_Massless.wl\>\""}], "}"}], "]"}], "]"}],
   ";", 
  RowBox[{"hrfEx02PostLoadCheck", "[", "]"}]}]], "Input",
 CellLabel->"In[1]:=",ExpressionUUID->"35c39a66-2df2-45b6-b25b-911e32d31da5"],

Cell["Channel convention and graphs", "Section",ExpressionUUID->"c498c1e3-0be6-4bc1-adfc-fca231d71ff1"],

Cell[BoxData[
 RowBox[{"hrfEx02ChannelLegend", "[", "]"}]], "Input",
 CellLabel->"In[2]:=",ExpressionUUID->"1ce4aa1b-cbf7-4cd0-8ea3-f666016c4dab"],

Cell[BoxData[
 RowBox[{"hrfEx02ShowDiagram", "[", 
  RowBox[{"CrownInternalEdges", ",", "CrownExternalEdges"}], "]"}]], "Input",
 CellLabel->"In[3]:=",ExpressionUUID->"cac03d77-ce5f-4a16-bc9b-476f6940732f"],

Cell[BoxData[
 RowBox[{"hrfEx02ShowDiagram", "[", 
  RowBox[{"SuperCrownInternalEdges", ",", "CrownExternalEdges"}], 
  "]"}]], "Input",
 CellLabel->"In[4]:=",ExpressionUUID->"065950a5-5cd0-4d58-a925-91b991a4a995"],

Cell[BoxData[
 RowBox[{"hrfEx02ShowDiagram", "[", 
  RowBox[{"HyperCrownInternalEdges", ",", "CrownExternalEdges"}], 
  "]"}]], "Input",
 CellLabel->"In[5]:=",ExpressionUUID->"2f0feb75-a19b-4d02-95b6-de54ff39d1d9"],

Cell[BoxData[
 RowBox[{"hrfEx02ShowDiagram", "[", 
  RowBox[{"DBInternalEdges", ",", "DBExternalEdges"}], "]"}]], "Input",
 CellLabel->"In[6]:=",ExpressionUUID->"e5567337-0296-4593-9b70-d3ad04388937"],

Cell["Crown interior positive control", "Section",ExpressionUUID->"170a4ced-f446-43f8-9739-0b80ab70b26f"],

Cell["\<\
Runs wide angle plus the three Regge channels for the Crown interior. This is \
the positive control for the Regge path.\
\>", "Text",ExpressionUUID->"e3626362-34ce-46f0-9833-c217e643b9bf"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Ex02CrownInterior", "=", 
   RowBox[{"hrfEx02InteriorStudy", "[", 
    RowBox[{"\"\<Crown\>\"", ",", 
     RowBox[{"Ex02Diagrams", "[", "\"\<Crown\>\"", "]"}], ",", "20"}], 
    "]"}]}], ";", 
  RowBox[{"Dataset", "[", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"KeyTake", "[", 
       RowBox[{
        RowBox[{"Ex02CrownInterior", "[", "#1", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"\"\<Kinematic regime\>\"", 
          ",", "\"\<Hidden region identified?\>\"", 
          ",", "\"\<Scaling status\>\"", ",", "\"\<Scaling vector\>\""}], 
         "}"}]}], "]"}], "&"}], ")"}], "/@", 
    RowBox[{"{", 
     RowBox[{"\"\<Wide\>\"", ",", "\"\<T23\>\"", ",", "\"\<T12\>\"", 
      ",", "\"\<T13\>\""}], "}"}]}], "]"}]}]], "Input",
 CellLabel->"In[7]:=",ExpressionUUID->"5ace99a7-3739-443f-a491-c21cb9e0480a"],

Cell["SuperCrown boundary x8 = x9 = 0", "Section",ExpressionUUID->"1a21428e-8f35-4727-bb4d-a3d68432d793"],

Cell["\<\
Expected current result: accepted hidden region in wide angle and in all \
three Regge channels.\
\>", "Text",ExpressionUUID->"7af57365-765a-48da-ad3d-2542cffd437a"],

Cell[BoxData[
 RowBox[{"hrfEx02RunSuperCrownBoundary", "[", "]"}]], "Input",
 CellLabel->"In[8]:=",ExpressionUUID->"e1a0bf16-306e-412d-976b-22d6ad13d9b2"],

Cell[BoxData[
 RowBox[{"InterpretationBox", "[", 
  RowBox[{
   RowBox[{"StyleBox", "[", 
    RowBox[{"\"\<Ex02SuperCrownReggeChannelSummary\>\"", ",", 
     RowBox[{"ShowStringCharacters", "\[Rule]", "True"}]}], "]"}], ",", 
   "Ex02SuperCrownReggeChannelSummary", ",", 
   RowBox[{"Editable", "\[Rule]", "False"}]}], "]"}]], "Input",
 CellLabel->"In[9]:=",ExpressionUUID->"daf746d1-eb06-4dbf-9a08-64fe0950f9c7"],

Cell[BoxData[
 RowBox[{"InterpretationBox", "[", 
  RowBox[{
   RowBox[{"StyleBox", "[", 
    RowBox[{"\"\<Ex02SuperCrownBoundaryDetailTable\>\"", ",", 
