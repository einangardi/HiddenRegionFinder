Cell[BoxData[
 RowBox[{
  RowBox[{"hrfSCWideReport", "=", 
   RowBox[{"hrfEx02ReggeChannelDisplay", "[", 
    RowBox[{"\"\<SuperCrown\>\"", ",", "\"\<Boundary {x8,x9}\>\"", 
     ",", "\"\<Wide\>\""}], "]"}]}], ";", 
  RowBox[{"KeyTake", "[", 
   RowBox[{
    RowBox[{"hrfSCWideReport", "[", "\"\<Ingredients\>\"", "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"\"\<Generators\>\"", ",", "\"\<ScalingVector\>\"", 
      ",", "\"\<VariableScaling\>\"", ",", "\"\<HiddenRegionQ\>\""}], "}"}]}],
    "]"}]}]], "Input",
 CellLabel->"In[11]:=",ExpressionUUID->"66916574-7b34-464d-aa58-862ba20e21c9"],

Cell["HyperCrown boundary x11 = 0", "Section",ExpressionUUID->"21d5644a-0f61-4dec-bccf-300b7f7b3c3b"],

Cell["\<\
This is slower than SuperCrown. In the monitored split run, the accepted \
Regge boundary HR appeared in channel T12; wide angle is handled in notebook \
01.\
\>", "Text",ExpressionUUID->"fa17f023-81d7-46bc-a6d2-f97e98d9cd61"],

Cell[BoxData[
 RowBox[{"hrfEx02RunHyperCrownBoundary", "[", "]"}]], "Input",
 CellLabel->"In[12]:=",ExpressionUUID->"97beba09-5b39-41e8-9dc7-02854ee44fa5"],

Cell[BoxData[
 RowBox[{"InterpretationBox", "[", 
  RowBox[{
