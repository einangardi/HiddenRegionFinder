  "]"}]], "Input",
 CellLabel->"In[17]:=",ExpressionUUID->"05ef5953-05c6-45fb-a1ed-768cc53dca84"],

Cell["Optional interiors", "Section",ExpressionUUID->"78db250c-c8c7-4a60-97a5-e7fff1b4651f"],

Cell["\<\
Run only when needed; HyperCrown interior is slow. These calls use the same \
current Regge path one diagram at a time.\
\>", "Text",ExpressionUUID->"ad8f09c3-6bcc-4da5-b9a0-d8fa7ef92399"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Ex02SuperCrownInterior", "=", 
   RowBox[{"hrfEx02InteriorStudy", "[", 
    RowBox[{"\"\<SuperCrown\>\"", ",", 
     RowBox[{"Ex02Diagrams", "[", "\"\<SuperCrown\>\"", "]"}], ",", "20"}], 
    "]"}]}], ";", 
  RowBox[{"Ex02HyperCrownInterior", "=", 
   RowBox[{"hrfEx02InteriorStudy", "[", 
    RowBox[{"\"\<HyperCrown\>\"", ",", 
     RowBox[{"Ex02Diagrams", "[", "\"\<HyperCrown\>\"", "]"}], ",", "30"}], 
    "]"}]}], ";", 
  RowBox[{"Ex02DBInterior", "=", 
   RowBox[{"hrfEx02InteriorStudy", "[", 
    RowBox[{"\"\<Diving Beetle\>\"", ",", 
     RowBox[{"Ex02Diagrams", "[", "\"\<Diving Beetle\>\"", "]"}], ",", "20"}],
     "]"}]}], ";"}]], "Input",
 CellLabel->"In[18]:=",ExpressionUUID->"aad99c5d-98b1-47ca-9231-e3dfeaa97cfb"]
