   RowBox[{"Editable", "\[Rule]", "False"}]}], "]"}]], "Input",
 CellLabel->"In[14]:=",ExpressionUUID->"251da464-9a9c-4091-927e-c79c4f4efecd"],

Cell[BoxData[
 RowBox[{
  RowBox[{"hrfHCT12Report", "=", 
   RowBox[{"hrfEx02ReggeChannelDisplay", "[", 
    RowBox[{"\"\<HyperCrown\>\"", ",", "\"\<Boundary {x11}\>\"", 
     ",", "\"\<T12\>\""}], "]"}]}], ";", 
  RowBox[{"KeyTake", "[", 
   RowBox[{
    RowBox[{"hrfHCT12Report", "[", "\"\<Ingredients\>\"", "]"}], ",", 
