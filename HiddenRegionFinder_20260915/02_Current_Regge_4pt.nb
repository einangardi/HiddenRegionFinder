    "]"}]}]], "Input",
 CellLabel->"In[15]:=",ExpressionUUID->"f08e51d3-b261-4210-b494-cae8b6f3ef64"],

Cell["Diving Beetle boundary x8 = x9 = 0", "Section",ExpressionUUID->"3156f7ce-1d77-407d-8692-c62e7ed5db89"],

Cell["\<\
This is the current negative control in the tested Regge boundary stratum.\
\>", "Text",ExpressionUUID->"2459c839-caff-4f0e-a463-a55937ba3ac2"],

Cell[BoxData[
 RowBox[{"hrfEx02RunDBBoundary", "[", "]"}]], "Input",
 CellLabel->"In[16]:=",ExpressionUUID->"3a8f4dab-f003-493e-b3b8-a24bd7658053"],

Cell[BoxData[
