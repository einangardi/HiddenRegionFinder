Cell["4. Every exact local-facet certificate", "Section",ExpressionUUID->"84a47f48-7ded-455f-9af1-4ee62e7d7f37"],

Cell["\<\
ScalefulQ is the conjunction of ExactLowerFacetQ, CompleteFacetRankQ, \
HiddenHierarchyQ and PositiveTransverseSuppressionsQ. The full PullbackChecks \
associations are retained in the accompanying WL result file.\
\>", "Text",ExpressionUUID->"bd87e14d-c9e2-4d63-8473-8e6fb843eee9"],

Cell[BoxData[
 TagBox[
  TagBox[
   DynamicModuleBox[{TypeSystem`NestedGrid`PackagePrivate`$state$$ = <|
    "InitialData" -> {<|
       "Candidate" -> 1, "LocalFacet" -> 1, 
        "BoundaryZeroVariables" -> {$CellContext`x7}, 
        "PullbackVector" -> {-2, -5, -2, -6, -2, -6, -5, "boundary", -2}, 
        "WSL" -> -12, "WHR" -> -8, "CancellationDepth" -> 4, 
        "TransverseSuppressions" -> <|-$CellContext`x3 - $CellContext`x3 \
$CellContext`X45 + $CellContext`Kz $CellContext`x1 $CellContext`X45 \
$CellContext`X56h -> 
          2, -$CellContext`x5 - $CellContext`X45 $CellContext`x5 + \
$CellContext`X34h $CellContext`X45 $CellContext`x6 -> 2|>, 
        "LeadingFacetSourceCounts" -> <|
         "FOutside" -> 18, "U" -> 6, "FSL" -> 2|>, "ScalefulQ" -> True|>, <|
