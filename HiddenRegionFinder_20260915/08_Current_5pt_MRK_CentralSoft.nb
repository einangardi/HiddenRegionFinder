Cell[CellGroupData[{

Cell["Exact equivalence with the earlier light-cone audit", "Subsection",ExpressionUUID->"4edfea49-4361-4f0f-849f-00a6d928323f"],

Cell["\<\
The certified runs were originally expressed with finite coefficients \
P,K,M,R,T,C. They are exactly the same path under Q4hat2=R, X34hat=P/K, \
X45hat=K M/T, zetaHat zetaBarHat=R/T and zetaHat+zetaBarHat=sigma C/T. The \
physical domain P,M,K,R,T,C>0 and C^2<4 R T, with both transverse signs sigma \
checked, supplies an explicit positivity realization. This section is \
retained as an equivalence audit, not as a second definition of the limit.\
\>", "Text",ExpressionUUID->"da2c6866-15fc-4da9-afb2-9767d1fcc772"],

Cell[BoxData[
 RowBox[{"hrf5MRKExactCentralSoftRules", "[", 
  RowBox[{"1", ",", "2", ",", "1"}], "]"}]], "Input",
 CellLabel->"In[1]:=",ExpressionUUID->"c6b11251-4e7b-4758-aebe-b111004ea09e"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"s12", "\[Rule]", 
    RowBox[{
     RowBox[{"C", " ", "delta"}], "+", 
     FractionBox[
      RowBox[{"K", " ", "M"}], "delta"], "+", 
     FractionBox[
      RowBox[{"M", " ", "P"}], 
      SuperscriptBox["delta", "4"]], "+", 
     RowBox[{"2", " ", 
      SuperscriptBox["delta", "2"], " ", "R"}], "+", 
     FractionBox[
      RowBox[{"C", " ", 
       SuperscriptBox["delta", "4"], " ", "R"}], 
      RowBox[{"K", " ", "M"}]], "+", 
     FractionBox[
      RowBox[{"P", " ", "R"}], 
      RowBox[{"delta", " ", "K"}]], "+", 
     FractionBox[
      RowBox[{
       SuperscriptBox["delta", "5"], " ", 
       SuperscriptBox["R", "2"]}], 
      RowBox[{"K", " ", "M"}]], "+", 
     RowBox[{"2", " ", "T"}], "+", 
     FractionBox[
      RowBox[{
       SuperscriptBox["delta", "3"], " ", "K", " ", "T"}], "P"], "+", 
