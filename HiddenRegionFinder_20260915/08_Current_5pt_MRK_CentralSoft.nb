       "$HRF5MRKNotebookDirectory", ",", "\"\<examples\>\"", 
        ",", "\"\<five_point_mrk_central_soft\>\""}], "}"}], "]"}]}], "]"}]}],
   ";", 
  RowBox[{"$HRF5MRKRepoDirectory", "=", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"FileExistsQ", "[", 
      RowBox[{"FileNameJoin", "[", 
       RowBox[{"{", 
        RowBox[{
        "$HRF5MRKNotebookDirectory", ",", "\"\<HiddenRegionFinder.wl\>\""}], 
        "}"}], "]"}], "]"}], ",", "$HRF5MRKNotebookDirectory", ",", 
     RowBox[{"DirectoryName", "[", 
      RowBox[{"DirectoryName", "[", "$HRF5MRKSupportDirectory", "]"}], 
      "]"}]}], "]"}]}], ";", 
  RowBox[{"$HRF5MRKLibraryOnly", "=", "True"}], ";", 
  RowBox[{"Get", "[", 
   RowBox[{"FileNameJoin", "[", 
    RowBox[{"{", 
     RowBox[{
     "$HRF5MRKSupportDirectory", 
      ",", "\"\<HRF_FivePointMRKExploratory.wl\>\""}], "}"}], "]"}], "]"}], ";", 
  RowBox[{"FivePointMRKSummary", "=", 
   RowBox[{"Get", "[", 
    RowBox[{"FileNameJoin", "[", 
     RowBox[{"{", 
      RowBox[{
      "$HRF5MRKSupportDirectory", ",", "\"\<certified_summary.wl\>\""}], 
      "}"}], "]"}], "]"}]}]}]], "Input",
 CellLabel->"In[4]:=",ExpressionUUID->"1daa158c-e41b-4fdf-98a7-00ca4860cdb4"],

Cell["\<\
Run one targeted certificate with the command below in a terminal from this \
directory. The last arguments are order index, chart, a, b, topology.\
\>", "Text",ExpressionUUID->"ff91cfb5-c30c-484f-82d2-e1cecd8c6c0c"],

Cell["\<\
wolframscript -file HRF_FivePointMRKTargetedRun.wl 2 exact-soft-plus 1 2 seed\
\
\>", "Program",ExpressionUUID->"8c697a40-ff06-4495-a757-cf490312c61b"],

Cell["\<\
wolframscript -file HRF_RunFivePointMRKAllLabelFullLayerAudit.wl 1 2 plus\
\>", "Program",ExpressionUUID->"971e9b81-ad6f-4e4b-9dc4-c9a77099bbea"],

Cell["Rebuild the compact summary and this notebook with:", "Text",ExpressionUUID->"d701e021-a22e-4681-b742-99965d9778dd"],

Cell["\<\
wolframscript -file HRF_FivePointMRKBuildSummary.wl
wolframscript -file rebuild_five_point_mrk_notebook.wl\
\>", "Program",ExpressionUUID->"8c3e73e7-2240-4b2c-b01b-2402241fec52"]
},
