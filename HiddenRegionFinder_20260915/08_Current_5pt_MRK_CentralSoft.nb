      StripOnInput->False,
      FontWeight->Bold], 
     StyleBox["\<\"routing (q0,...,q5)\"\>",
      StripOnInput->False,
      FontWeight->Bold]},
    {"\<\"p4 at endpoint 5\"\>", "\<\"{1,2,3,5,4}\"\>", 
     StyleBox["\<\"{\\\"r\\\", \\\"p1-r\\\", \\\"p3-ell\\\", \
\\\"ell+p2-p3\\\", \\\"r-ell\\\", \\\"p5-r+ell\\\"}\"\>",
      StripOnInput->False,
      FontFamily->"Source Code Pro"]},
    {"\<\"p4 at endpoint 3\"\>", "\<\"{1,2,4,5,3}\"\>", 
