       SuperscriptBox["T", "2"]}], 
      RowBox[{"M", " ", "P"}]]}]}], ",", 
   RowBox[{"s23", "\[Rule]", 
    RowBox[{
     RowBox[{"-", "T"}], "-", 
     FractionBox[
      RowBox[{
       SuperscriptBox["delta", "3"], " ", "K", " ", "T"}], "P"], "-", 
     FractionBox[
      RowBox[{"C", " ", 
       SuperscriptBox["delta", "5"], " ", "T"}], 
      RowBox[{"M", " ", "P"}]], "-", 
     FractionBox[
      RowBox[{
