      RowBox[{"M", " ", "P"}]], "+", 
     FractionBox[
      RowBox[{
       SuperscriptBox["delta", "3"], " ", "R", " ", "T"}], 
      RowBox[{"K", " ", "M"}]], "+", 
     FractionBox[
      RowBox[{
