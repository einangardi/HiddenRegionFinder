      RowBox[{"M", " ", "P"}]], "-", 
     FractionBox[
      RowBox[{
       SuperscriptBox["delta", "4"], " ", 
       SuperscriptBox["T", "2"]}], 
      RowBox[{"M", " ", "P"}]]}]}], ",", 
   RowBox[{"s34", "\[Rule]", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "C"}], " ", "delta"}], "+", 
     FractionBox[
      RowBox[{"P", " ", "R"}], 
      RowBox[{"delta", " ", "K"}]], "+", 
     FractionBox[
      RowBox[{
       SuperscriptBox["delta", "3"], " ", "K", " ", "T"}], "P"]}]}], ",", 
   RowBox[{"s45", "\[Rule]", 
    RowBox[{
     RowBox[{"C", " ", "delta"}], "+", 
     FractionBox[
      RowBox[{"K", " ", "M"}], "delta"], "+", 
     RowBox[{"2", " ", 
      SuperscriptBox["delta", "2"], " ", "R"}], "+", 
     FractionBox[
      RowBox[{"C", " ", 
       SuperscriptBox["delta", "4"], " ", "R"}], 
      RowBox[{"K", " ", "M"}]], "+", 
     FractionBox[
      RowBox[{
       SuperscriptBox["delta", "5"], " ", 
       SuperscriptBox["R", "2"]}], 
      RowBox[{"K", " ", "M"}]], "+", 
     FractionBox[
      RowBox[{
       SuperscriptBox["delta", "3"], " ", "R", " ", "T"}], 
      RowBox[{"K", " ", "M"}]]}]}], ",", 
   RowBox[{"s15", "\[Rule]", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "C"}], " ", "delta"}], "-", 
     RowBox[{
      SuperscriptBox["delta", "2"], " ", "R"}], "-", 
     FractionBox[
      RowBox[{"C", " ", 
       SuperscriptBox["delta", "4"], " ", "R"}], 
      RowBox[{"K", " ", "M"}]], "-", 
