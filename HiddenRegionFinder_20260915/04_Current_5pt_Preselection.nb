Notebook[{

Cell[CellGroupData[{
Cell["Current 5-point topology preselection", "Title",ExpressionUUID->"97c1d948-4ca8-408e-82e6-e0a240df9e6e"],

Cell["\<\
Current preselection notebook: recursive derivative preselection only, with \
the handoff fixture used by the five-point HRF scan.\
\>", "Text",ExpressionUUID->"2bae3e29-b342-4fa1-987f-7f0c666447bf"],

Cell["Setup", "Section",ExpressionUUID->"a13bf73d-fe60-4ad7-b900-5548fd9f03ee"],

Cell[BoxData[
 RowBox[{
  RowBox[{"$HRFQuietReports", "=", "True"}], ";", 
  RowBox[{"Get", "[", 
   RowBox[{"FileNameJoin", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"NotebookDirectory", "[", "]"}], 
      ",", "\"\<HRF_RecursiveDerivativePreselection.wl\>\""}], "}"}], "]"}], 
   "]"}], ";"}]], "Input",
 CellLabel->"In[1]:=",ExpressionUUID->"64bf58d5-1671-47f6-8c6f-d87e0a5918cc"],

Cell["Run recursive derivative preselection", "Section",ExpressionUUID->"783534a0-0150-4baa-891e-0b1b5b4afdea"],

Cell["\<\
This produces the 70 representative topology handoff. PreselectionZeroVars \
are diagnostic provenance for the recursive sign test; HRF still receives the \
original listed graph.\
\>", "Text",ExpressionUUID->"6c4d2ba2-864a-447e-8806-be7f9510125d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"RDScan", "=", 
   RowBox[{"hrfRunRecursiveDerivativePreselection", "[", "]"}]}], ";", 
  RowBox[{"RDScan", "[", "\"\<Summary\>\"", "]"}]}]], "Input",
 CellLabel->"In[2]:=",ExpressionUUID->"0fc5f9e3-676d-498d-9010-4a63b524050a"],

Cell[BoxData[
 RowBox[{"RDScan", "[", "\"\<CandidateDataset\>\"", "]"}]], "Input",
 CellLabel->"In[3]:=",ExpressionUUID->"3912bff6-2823-4b39-8f59-508a5aee8fc7"],

Cell[BoxData[
 RowBox[{"hrfRecursiveCandidateDrawingGrid", "[", 
  RowBox[{
   RowBox[{"Take", "[", 
    RowBox[{
     RowBox[{"RDScan", "[", "\"\<CandidateRows\>\"", "]"}], ",", 
     RowBox[{"UpTo", "[", "20", "]"}]}], "]"}], ",", "2"}], "]"}]], "Input",
 CellLabel->"In[4]:=",ExpressionUUID->"44f177d8-7998-4c4f-b697-b2cc4d54a8a0"],

Cell["Export handoff fixture", "Section",ExpressionUUID->"9f77cb8f-15ad-44d2-8c1a-89566cfdd9a8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Export", "[", 
   RowBox[{
    RowBox[{"FileNameJoin", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"NotebookDirectory", "[", "]"}], 
       ",", "\"\<RecursiveDerivativePreselectionHandoff.csv\>\""}], "}"}], 
     "]"}], ",", 
    RowBox[{"hrfRecursiveCSVTable", "[", 
     RowBox[{"RDScan", "[", "\"\<CandidateHandoffRows\>\"", "]"}], "]"}]}], 
   "]"}], ";", 
  RowBox[{
   RowBox[{"RDScan", "[", "\"\<CandidateHandoffRows\>\"", "]"}], ">>", 
   InterpretationBox[
    RowBox[{"FileNameJoin", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"NotebookDirectory", "[", "]"}], 
       ",", "\"\<RecursiveDerivativePreselectionHandoff.wl\>\""}], "}"}], 
     "]"}],
    FileNameJoin[{
      NotebookDirectory[], "RecursiveDerivativePreselectionHandoff.wl"}],
    Editable->False]}], ";"}]], "Input",
 CellLabel->"In[5]:=",ExpressionUUID->"204b253a-bb51-4623-866d-c45e4166a7aa"]
}, Open  ]]
},
