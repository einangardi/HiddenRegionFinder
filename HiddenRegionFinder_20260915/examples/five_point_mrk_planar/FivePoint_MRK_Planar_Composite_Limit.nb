Notebook[{
Cell["Five-point MRK plus near-planarity", "Title",ExpressionUUID->"aed9d4dd-9245-42a0-b90e-99c609cddbae"],

Cell["\<\
A simultaneous fixed-transverse multi-Regge and coplanar-limit audit\
\>", "Subtitle",ExpressionUUID->"5cb7986c-a05d-49d8-b98e-e809660dafc9"],

Cell["\<\
This notebook studies the two-loop six-edge fish topology in a composite \
limit in which both rapidity gaps become large while the transverse \
configuration approaches the coplanar boundary.  It places this limit on the \
same footing as the wide-angle near-planar and central-soft rapidity-ordered \
expansions.  All vectors are displayed as (v0,...,v5;1), including the \
expansion-parameter component.\
\>", "Text",ExpressionUUID->"f54c4793-fe6a-4332-bcf9-9783696ef5a2"],

Cell["1. Definition of the composite limit", "Section",
 CellGroupingRules->{
  "SectionGrouping", 
   50},ExpressionUUID->"daa53281-2ea4-4f2e-943b-49e9993fcd9a"],

Cell["\<\
We start from the exact on-shell light-cone chart used for general five-point \
kinematics.  The outgoing transverse momenta are p3_perp=q, p4_perp=k and \
p5_perp=-q-k.  Pp, Kp, Mm, Q2 and xi are fixed and positive.  Two independent \
positive integers a and b control the approach to planarity and the MRK \
rapidity growth, respectively.\
\>", "Text",ExpressionUUID->"8b923acc-9f88-43d9-a491-eb59fe24be52"],

Cell[BoxData[
 TagBox[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{"{", 
      RowBox[{"p3plus", ",", "p4plus", ",", "p5minus"}], "}"}], "\[LongEqual]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Pp", " ", 
        SuperscriptBox["delta", 
         RowBox[{"-", "b"}]]}], ",", "Kp", ",", 
       RowBox[{"Mm", " ", 
        SuperscriptBox["delta", 
         RowBox[{"-", "b"}]]}]}], "}"}]}],
    HoldForm],
   TraditionalForm],
  TraditionalForm,
  Editable->True]], "DisplayFormula",ExpressionUUID->"744dc348-23fb-43cb-b789-\
1c22828398f5"],

Cell[BoxData[
 TagBox[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{"{", 
      RowBox[{"k2", ",", "q2", ",", "twoqdotk"}], "}"}], "\[LongEqual]", 
     RowBox[{"{", 
      RowBox[{"Q2", ",", 
       RowBox[{"Q2", " ", 
        RowBox[{"(", 
         RowBox[{
          FractionBox["1", 
           SuperscriptBox["xi", "2"]], "+", 
          FractionBox[
           SuperscriptBox["delta", 
            RowBox[{"2", " ", "a"}]], "4"]}], ")"}]}], ",", 
       FractionBox[
        RowBox[{"2", " ", "Q2"}], "xi"]}], "}"}]}],
    HoldForm],
   TraditionalForm],
  TraditionalForm,
  Editable->True]], "DisplayFormula",ExpressionUUID->"b02deafe-43ec-4e58-bfa5-\
e011006e099f"],

Cell[BoxData[
 TagBox[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{"{", 
      RowBox[{"w", ",", "wbar"}], "}"}], "\[LongEqual]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"-", 
         FractionBox["1", "xi"]}], "+", 
        FractionBox[
         RowBox[{"\[ImaginaryI]", " ", 
          SuperscriptBox["delta", "a"]}], "2"]}], ",", 
       RowBox[{
        RowBox[{"-", 
         FractionBox["1", "xi"]}], "-", 
        FractionBox[
         RowBox[{"\[ImaginaryI]", " ", 
          SuperscriptBox["delta", "a"]}], "2"]}]}], "}"}]}],
    HoldForm],
   TraditionalForm],
  TraditionalForm,
  Editable->True]], "DisplayFormula",ExpressionUUID->"79b632fd-276e-41ad-ac09-\
36b80f9384a4"],

Cell["\<\
Both rapidity gaps therefore scale in the standard fixed-transverse MRK \
manner.  Planarity is projective: the dimensionful Gram determinant contains \
the growing hard scale, but exactly Gamma5/s12^2=-Q2^2 delta^(2a).  It is \
this normalized quantity that tends to zero.\
\>", "Text",ExpressionUUID->"f936cf79-e1af-48e6-9324-4425a13fde86"],

Cell["2. Topology, attachment and invariant stationary form", "Section",
 CellGroupingRules->{
  "SectionGrouping", 
   50},ExpressionUUID->"efbb0c59-9abe-4fc1-bab4-ea97a6ed23f9"],

Cell["\<\
The graph is a theta graph with paths A=(x0,x1), B=(x2,x3), C=(x4,x5).  Its \
four-valent endpoint vertices are 3 and 5; vertices 1, 2 and 4 lie in the \
interiors of the three paths and are trivalent after attaching an external \
leg.  The calculation below uses external attachment order {1,2,3,5,4}: p3 \
and p4 occupy the four-valent endpoints, while the backward extremal parton \
p5 is attached to the trivalent vertex 4.  It is therefore not the \
rapidity-symmetric attachment.\
\>", "Text",ExpressionUUID->"81e98559-fc09-4d64-82b2-bb002d8b97fb"],

Cell[BoxData[
 GraphicsBox[
  {GrayLevel[0], AbsoluteThickness[2], LineBox[{{-1.2, 1.}, {1., 0.75}}], 
   LineBox[{{-1.2, 1.}, {1., -0.75}}], LineBox[{{-1.2, -0.9}, {1., 0.75}}], 
   LineBox[{{-1.2, -0.9}, {1., -0.75}}], LineBox[{{1., 0.75}, {0., -1.65}}], 
   LineBox[{{0., -1.65}, {1., -0.75}}], 
   {AbsolutePointSize[7], 
    PointBox[{{-1.2, 1.}, {-1.2, -0.9}, {1., 0.75}, {0., -1.65}, {
     1., -0.75}}], 
    {AbsoluteThickness[1.7], LineBox[{{-1.2, 1.}, {-2.1, 1.35}}], 
     LineBox[{{-1.2, -0.9}, {-2.1, -1.25}}], 
     LineBox[{{1., 0.75}, {2., 1.15}}], LineBox[{{1., -0.75}, {2., -0.55}}], 
     LineBox[{{0., -1.65}, {0.55, -2.3}}], InsetBox[
      StyleBox["\<\"x0\"\>",
       StripOnInput->False,
       FontSize->13], {-0.05, 1.06}], InsetBox[
      StyleBox["\<\"x1\"\>",
       StripOnInput->False,
       FontSize->13], {-0.02, 0.02}], InsetBox[
      StyleBox["\<\"x2\"\>",
       StripOnInput->False,
       FontSize->13], {-0.35, -0.02}], InsetBox[
      StyleBox["\<\"x3\"\>",
       StripOnInput->False,
       FontSize->13], {0.15, -0.72}], InsetBox[
      StyleBox["\<\"x4\"\>",
       StripOnInput->False,
       FontSize->13], {0.72, -0.38}], InsetBox[
      StyleBox["\<\"x5\"\>",
       StripOnInput->False,
       FontSize->13], {0.38, -1.27}], InsetBox[
      StyleBox["\<\"p1\"\>",
       StripOnInput->False,
       FontSize->14], {-2.25, 1.48}], InsetBox[
      StyleBox["\<\"p2\"\>",
       StripOnInput->False,
       FontSize->14], {-2.25, -1.38}], InsetBox[
      StyleBox["\<\"p3\"\>",
       StripOnInput->False,
       FontSize->14], {2.12, 1.23}], InsetBox[
      StyleBox["\<\"p4\"\>",
       StripOnInput->False,
       FontSize->14], {2.12, -0.48}], InsetBox[
      StyleBox["\<\"p5\"\>",
       StripOnInput->False,
       FontSize->14], {0.65, -2.42}]}}},
  ImageSize->500,
  PlotRange->{{-2.55, 2.4}, {-2.6, 1.65}}]], "Output",ExpressionUUID->\
"1c491bc7-0bd3-484f-a9d6-fcf0d3f0ba12"],

Cell[BoxData[
 TagBox[GridBox[{
    {"\<\"attachment order at vertices 1,...,5\"\>", "\<\"four-valent \
endpoints\"\>", "\<\"location of p4\"\>", "\<\"positive stationary \
point?\"\>"},
    {"\<\"{1,2,3,5,4} (representative)\"\>", "\<\"{p3,p4}\"\>", "\<\"endpoint \
5\"\>", "\<\"yes\"\>"},
    {"\<\"{1,2,4,5,3} (endpoint reflection)\"\>", "\<\"{p4,p3}\"\>", \
"\<\"endpoint 3\"\>", "\<\"yes\"\>"},
    {"\<\"{1,2,3,4,5} (rapidity symmetric)\"\>", "\<\"{p3,p5}\"\>", \
"\<\"trivalent path vertex 4\"\>", "\<\"no\"\>"}
   },
   AutoDelete->False,
   GridBoxAlignment->{"Columns" -> {{Left}}},
   GridBoxBackground->{"Columns" -> {{None}}, "Rows" -> {
       RGBColor[0.94, 0.94, 0.94], None, None, None}},
   GridBoxFrame->{"Columns" -> {{True}}, "Rows" -> {{True}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}},
   GridBoxSpacings->{"Columns" -> {{1.1}}, "Rows" -> {{0.8}}}],
  "Grid"]], "Output",ExpressionUUID->"8a7ee879-2e3f-449b-b320-898a828caefa"],

Cell["\<\
The distinction is dynamical, not presentational.  An exact scan of the \
twelve inequivalent attachment orders finds a positive stationary point only \
for the representative order and its endpoint reflection.  In the \
superficially natural rapidity-symmetric order {1,2,3,4,5}, the extremal \
partons p3 and p5 occupy the four-valent endpoints and p4 is emitted from the \
trivalent path vertex.  Its stationary ratios instead behave as\
\>", "Text",ExpressionUUID->"960ef3c5-2cb3-4ee0-8486-f5a12f2f1e9b"],

Cell[BoxData[
 TagBox[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{"{", 
      RowBox[{"rhoA", ",", "rhoB", ",", "rhoC"}], "}"}], " ", 
     "\[AHat]\.88\.bc", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", 
        FractionBox[
         RowBox[{
          RowBox[{"(", 
           RowBox[{"Kp", " ", "Mm", " ", "xi"}], ")"}], " ", 
          SuperscriptBox["delta", 
           RowBox[{"-", "b"}]]}], "Q2"]}], ",", 
       FractionBox[
        RowBox[{
         RowBox[{"(", 
          RowBox[{"Kp", " ", 
           RowBox[{"(", 
            RowBox[{"1", "+", "xi"}], ")"}]}], ")"}], " ", 
         SuperscriptBox["delta", "b"]}], 
        RowBox[{"Pp", " ", "xi"}]], ",", 
       RowBox[{"-", 
        RowBox[{"(", 
         RowBox[{"1", "+", "xi"}], ")"}]}]}], "}"}]}],
    HoldForm],
   TraditionalForm],
  TraditionalForm,
  Editable->True]], "DisplayFormula",ExpressionUUID->"37fac760-ca7b-4ef3-b00c-\
336c3ca924ea"],

Cell["\<\
Two ratios are negative for all positive physical parameters, so this \
attachment has no positive first-sheet pinch on the coplanar MRK path.  The \
endpoint-reflected positive order has the same facet after x0<->x1, x2<->x3 \
and x4<->x5; its exceptional component is v3=b-2a rather than v2=b-2a.\
\>", "Text",ExpressionUUID->"c57a120c-c9df-40ee-bf29-a7c48a12cd1f"],

Cell["\<\
Define qAB=s12-s34-s45, qBC=-s12-s23+s45 and qCA=s23.  The three stationary \
ratios rho solve the invariant linear system K rho=-ell.  With fA=x0-rhoA x1 \
and cyclic analogues, the exact massless polynomial is\
\>", "Text",ExpressionUUID->"66e73d46-43f9-46f0-8657-a61fdcfe85cd"],

Cell[BoxData[
 TagBox[
  FormBox[
   TagBox[
    RowBox[{"F", "\[LongEqual]", 
     RowBox[{
      RowBox[{"qAB", " ", "x5", " ", "fA", " ", "fB"}], "+", 
      RowBox[{"qBC", " ", "x1", " ", "fB", " ", "fC"}], "+", 
      RowBox[{"qCA", " ", "x3", " ", "fC", " ", "fA"}], "+", 
      FractionBox[
       RowBox[{"Gamma5", " ", "x1", " ", "x3", " ", "x5"}], 
       RowBox[{"4", " ", "qAB", " ", "qBC", " ", "qCA"}]]}]}],
    HoldForm],
   TraditionalForm],
  TraditionalForm,
  Editable->True]], "DisplayFormula",ExpressionUUID->"d29cd836-9637-4b67-b1e6-\
a0eec416242e"],

Cell["\<\
The audit verifies this identity directly against the Symanzik polynomial in \
adjacent Mandelstam invariants.\
\>", "Text",ExpressionUUID->"66710c6f-41ab-4802-af3d-f9cc1c928655"],

Cell["3. The moving positive Landau locus", "Section",
 CellGroupingRules->{
  "SectionGrouping", 
   50},ExpressionUUID->"749a12a9-65f4-4e8e-b398-9c1c3aac3fa9"],

Cell["\<\
In this composite limit the stationary point is not fixed in projective \
Schwinger space.  Its ratios behave as\
\>", "Text",ExpressionUUID->"375ae39f-85d0-4951-a6db-c72702a1752d"],

Cell[BoxData[
 TagBox[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{"{", 
      RowBox[{"rhoA", ",", "rhoB", ",", "rhoC"}], "}"}], " ", 
     "\[AHat]\.88\.bc", " ", 
     RowBox[{"{", 
      RowBox[{"xi", ",", 
       FractionBox[
        RowBox[{"Kp", " ", 
         SuperscriptBox["delta", "b"]}], "Pp"], ",", "xi"}], "}"}]}],
    HoldForm],
   TraditionalForm],
  TraditionalForm,
  Editable->True]], "DisplayFormula",ExpressionUUID->"3335e831-2282-4dc5-889d-\
68753c64dec5"],

Cell["\<\
All three leading coefficients are positive for the physical parameter \
domain.  The middle ratio approaches a boundary at the MRK rate.  This moving \
Landau locus is the origin of the unequal x2 component in the final vector.\
\>", "Text",ExpressionUUID->"bc99dff4-652d-497a-8e0f-5021343843a3"],

Cell["4. Local facet and cancellation layers", "Section",
 CellGroupingRules->{
  "SectionGrouping", 
   50},ExpressionUUID->"de3664e6-a00d-4e36-a78a-a9052023728e"],

Cell["\<\
Introduce tangential coordinates uI and normal coordinates nI by\
\>", "Text",ExpressionUUID->"63634fb5-47b0-4c33-8574-0a63115b8216"],

Cell[BoxData[
 TagBox[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{"{", 
      RowBox[{"x0", ",", "x1", ",", "x2", ",", "x3", ",", "x4", ",", "x5"}], 
      "}"}], "\[LongEqual]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"rhoA", " ", "uA"}], "+", "nA"}], ",", "uA", ",", 
       RowBox[{
        RowBox[{"rhoB", " ", "uB"}], "+", "nB"}], ",", "uB", ",", 
       RowBox[{
        RowBox[{"rhoC", " ", "uC"}], "+", "nC"}], ",", "uC"}], "}"}]}],
    HoldForm],
   TraditionalForm],
  TraditionalForm,
  Editable->True]], "DisplayFormula",ExpressionUUID->"2d87ac71-1c38-4c99-bb1b-\
b15fcbb77ef0"],

Cell["The exact lower-facet scaling in these coordinates is", "Text",ExpressionUUID->"ba811c31-754b-46d7-b297-14aba8137bc4"],

Cell[BoxData[
 TagBox[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{"{", 
      RowBox[{"uA", ",", "uB", ",", "uC", ",", "nA", ",", "nB", ",", "nC"}], 
      "}"}], " ", "\[AHat]\.88\.bc", " ", 
     RowBox[{"{", 
      RowBox[{
       SuperscriptBox["delta", 
        RowBox[{
         RowBox[{"-", "2"}], " ", "a"}]], ",", 
       SuperscriptBox["delta", 
        RowBox[{
         RowBox[{"-", "2"}], " ", "a"}]], ",", 
       SuperscriptBox["delta", 
        RowBox[{
         RowBox[{"-", "2"}], " ", "a"}]], ",", 
       SuperscriptBox["delta", 
        RowBox[{"-", "a"}]], ",", 
       SuperscriptBox["delta", 
        RowBox[{
         RowBox[{"-", "a"}], "+", 
         RowBox[{"2", " ", "b"}]}]], ",", 
       SuperscriptBox["delta", 
        RowBox[{"-", "a"}]]}], "}"}]}],
    HoldForm],
   TraditionalForm],
  TraditionalForm,
  Editable->True]], "DisplayFormula",ExpressionUUID->"697499ef-2b51-4f24-9668-\
c81b756523bd"],

Cell["Pulling this back to the original variables gives", "Text",ExpressionUUID->"b8e169fc-2749-4a4e-96fa-625c721cf39f"],

Cell[BoxData[
 TagBox[
  FormBox[
   TagBox[
    RowBox[{"vMRKPlanar", "\[LongEqual]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "2"}], " ", "a"}], ",", 
       RowBox[{
        RowBox[{"-", "2"}], " ", "a"}], ",", 
       RowBox[{"b", "-", 
        RowBox[{"2", " ", "a"}]}], ",", 
       RowBox[{
        RowBox[{"-", "2"}], " ", "a"}], ",", 
       RowBox[{
        RowBox[{"-", "2"}], " ", "a"}], ",", 
       RowBox[{
        RowBox[{"-", "2"}], " ", "a"}], ",", "1"}], "}"}]}],
    HoldForm],
   TraditionalForm],
  TraditionalForm,
  Editable->True]], "DisplayFormula",ExpressionUUID->"9ad0ad1f-d4cd-440d-80dc-\
113ae26e3160"],

Cell["\<\
The qAB and qBC sectors occur first at W=-6a-b and lose 2a+b powers through \
cancellation.  The qCA sector occurs at W=-6a and loses 2a powers.  Both \
reach WHR=-4a, where U and the Gram-normal term also enter.  Thus the \
equal-rate path has two cancellation layers, -7 and -6, before the resolved \
weight -4.\
\>", "Text",ExpressionUUID->"5bb5eed1-e1ba-453e-bf42-f8551ff77ad7"],

Cell["Exact equal-rate certificate", "Subsection",ExpressionUUID->"75917467-654c-492f-bd76-3bc8f9456778"],

Cell[BoxData[
 TagBox[GridBox[{
    {"\<\"original vector\"\>", 
     TemplateBox[{"  ", "\"  \"", 
       RowBox[{"-", "2"}], 
       RowBox[{"-", "2"}], 
       RowBox[{"-", "1"}], 
       RowBox[{"-", "2"}], 
       RowBox[{"-", "2"}], 
       RowBox[{"-", "2"}], "1"},
      "RowWithSeparators"]},
    {"\<\"local vector\"\>", 
     TemplateBox[{"  ", "\"  \"", 
       RowBox[{"-", "2"}], 
       RowBox[{"-", "2"}], 
       RowBox[{"-", "2"}], 
       RowBox[{"-", "1"}], "1", 
       RowBox[{"-", "1"}], "1"},
      "RowWithSeparators"]},
    {"\<\"leading monomials\"\>", "7"},
    {"\<\"affine rank\"\>", "6"},
    {"\<\"full lower facet\"\>", "True"},
    {"\<\"Gamma identity\"\>", "True"},
    {"\<\"invariant decomposition\"\>", "True"}
   },
   AutoDelete->False,
   GridBoxAlignment->{"Columns" -> {{Left}}},
   GridBoxFrame->{"Columns" -> {{True}}, "Rows" -> {{True}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Output",ExpressionUUID->"f668b3e7-4ed6-492b-8a72-a1f0dfad5312"],

Cell["\<\
The seven leading monomials span affine rank six in the six local variables.  \
This is the necessary full-dimensional lower-facet certificate; the result is \
not inferred merely from a candidate scaling vector.\
\>", "Text",ExpressionUUID->"09153ca4-5959-4a68-91f7-3c4b514bcc8d"],

Cell["Parameter-space power count", "Subsection",ExpressionUUID->"7ec911a4-8fe0-4510-8bc0-6a825ba3fe89"],

Cell["\<\
For unit propagator powers, the six local measures contribute delta^(-9a+2b). \
 Since the resolved Lee-Pomeransky polynomial has weight -4a, its power -D/2 \
contributes delta^(2a D).  Therefore\
\>", "Text",ExpressionUUID->"4c04ee95-a27f-4d34-9912-41ff10ebf05d"],

Cell[BoxData[
 TagBox[
  FormBox[
   TagBox[
    RowBox[{"IntegralScaling", "\[LongEqual]", 
     SuperscriptBox["delta", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "9"}], " ", "a"}], "+", 
       RowBox[{"2", " ", "b"}], "+", 
       RowBox[{"2", " ", "a", " ", "D"}]}]]}],
    HoldForm],
   TraditionalForm],
  TraditionalForm,
  Editable->True]], "DisplayFormula",ExpressionUUID->"9e3e0979-a9e9-4f0f-bba6-\
62d76be63f81"],

Cell["\<\
At equal rates and D=4-2 epsilon this is delta^(1-4 epsilon).  The \
epsilon-dependent exponent confirms that this is an infrared region even \
though the scalar integral is power suppressed in this dimensionful MRK chart.\
\>", "Text",ExpressionUUID->"bf9d25a3-b3e8-4f72-ab91-0c03fc3c3a0a"],

Cell["Momentum-space mode reconstruction", "Subsection",ExpressionUUID->"4151fb7a-4a0c-4444-8ad1-aee172f95070"],

Cell["\<\
For the positive representative attachment the equal-rate Landau saddle has \
the following component valuations.  Exactly at the saddle every propagator \
has virtuality O(delta^2).  The Schwinger vector nevertheless requires \
q2^2=O(delta) across the local integration region, so this dependent edge has \
one additional cancellation precisely at the saddle; that fact alone does not \
compare a mode-adapted independent loop momentum with its width.\
\>", "Text",ExpressionUUID->"a03466f0-377b-4093-ba60-82d8716a4828"],

Cell[BoxData[
 TagBox[GridBox[{
    {"\<\"edge\"\>", "\<\"central (plus, minus, transverse)\"\>", "\<\"saddle \
q_e^2 power\"\>", "\<\"region q_e^2 power\"\>"},
    {"\<\"x0\"\>", 
     TemplateBox[{"  ", "\"  \"", "3", 
       RowBox[{"-", "1"}], "1"},
      "RowWithSeparators"], "2", "2"},
    {"\<\"x1\"\>", 
     TemplateBox[{"  ", "\"  \"", "3", 
       RowBox[{"-", "1"}], "1"},
      "RowWithSeparators"], "2", "2"},
    {"\<\"x2\"\>", 
     TemplateBox[{"  ", "\"  \"", 
       RowBox[{"-", "1"}], "3", "1"},
      "RowWithSeparators"], "2", "1"},
    {"\<\"x3\"\>", 
     TemplateBox[{"  ", "\"  \"", "0", "3", "1"},
      "RowWithSeparators"], "2", "2"},
    {"\<\"x4\"\>", 
     TemplateBox[{"  ", "\"  \"", "1", 
       RowBox[{"-", "1"}], "0"},
      "RowWithSeparators"], "2", "2"},
    {"\<\"x5\"\>", 
     TemplateBox[{"  ", "\"  \"", "1", 
       RowBox[{"-", "1"}], "0"},
      "RowWithSeparators"], "2", "2"}
   },
   AutoDelete->False,
   GridBoxAlignment->{"Columns" -> {{Left}}},
   GridBoxBackground->{"Columns" -> {{None}}, "Rows" -> {
       RGBColor[0.94, 0.94, 0.94], None}},
   GridBoxFrame->{"Columns" -> {{True}}, "Rows" -> {{True}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Output",ExpressionUUID->"592aaf6e-666f-4b35-9b0c-636337106bef"],

Cell[BoxData[
 GraphicsBox[{
   {RGBColor[0., 0.8200000000000001, 0.], AbsoluteThickness[4], 
    BezierCurveBox[{{5, 8}, {3.25, 7.}, {2, 3}}], 
    BezierCurveBox[{{5, 2}, {3.25, 3.}, {2, 3}}]}, 
   {RGBColor[0.45, 0.5, 0.1], AbsoluteThickness[4], 
    BezierCurveBox[{{5, 8}, {3.2, 8.}, {2, 7}}], 
    BezierCurveBox[{{5, 2}, {3.2, 4.2}, {2, 7}}], 
