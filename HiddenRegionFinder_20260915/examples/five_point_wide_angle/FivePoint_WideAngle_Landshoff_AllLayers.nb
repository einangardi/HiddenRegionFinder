      FontWeight->Bold]},
    {"\<\"spacelike-collinear / Fig. 3\"\>", "\<\"(1,2,3,4,5)\"\>"},
    {"\<\"near-planar and representative central-soft\"\>", \
"\<\"(1,2,3,5,4)\"\>"}
   },
   AutoDelete->False,
   GridBoxAlignment->{"Columns" -> {{Left}}},
   GridBoxBackground->{"Columns" -> {{None}}, "Rows" -> {
       RGBColor[0.94, 0.96, 0.99], None}},
   GridBoxFrame->{"Columns" -> {{True}}, "Rows" -> {{True}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}},
   GridBoxSpacings->{"Columns" -> {{1.}}, "Rows" -> {{0.65}}}],
  "Grid"]], "Output",ExpressionUUID->"e962d7c7-597b-49af-840a-150cf832a18d"],

Cell["\<\
The earlier paper figure is one-based, whereas the executable notebooks are \
zero-based. The following map is used everywhere below:\
\>", "Text",ExpressionUUID->"5b7b2298-6f38-4036-bc3f-7ec74406d325"],

