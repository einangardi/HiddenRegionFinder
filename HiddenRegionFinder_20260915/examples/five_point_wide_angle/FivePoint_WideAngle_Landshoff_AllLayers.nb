Cell["Relation to x1 x4-x0 x5", "Subsection",ExpressionUUID->"fe82c41a-be90-49ea-9504-768aa0b63117"],

Cell[BoxData[
 TagBox[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"x1", " ", "x4"}], "-", 
     RowBox[{"x0", " ", "x5"}]}], "\[LongEqual]", 
    RowBox[{
     RowBox[{"-", 
      RowBox[{"fA", " ", "x5"}]}], "+", 
     RowBox[{"fC", " ", "x1"}], "+", 
     RowBox[{"x1", " ", "x5", " ", 
      RowBox[{"(", 
       RowBox[{"rhoC", "-", "rhoA"}], ")"}]}]}]}],
   TraditionalForm],
  TraditionalForm,
  Editable->True]], "Output",ExpressionUUID->"1e09c16f-0eda-405b-895f-\
8cdfc2945f49"],

Cell["\<\
The undressed binomial x1 x4-x0 x5 vanishes on the Landau locus only when \
rhoA=rhoC. That equality is imposed by the more special central-soft \
kinematics, but not by generic wide-angle kinematics. The symmetric generic \
description therefore uses the three path normals fA,fB,fC and their pairwise \
products.\
\>", "Text",ExpressionUUID->"aa58a167-4f4e-4977-9be3-aa1357734824"],

Cell["5. Near-planar expansion and scaling", "Section",ExpressionUUID->"aa617863-e9d9-4f81-bd96-bf05614f2207"],

Cell["\<\
Use a primitive real parameter lambda for the physical angular distance from \
the coplanar boundary:\
\>", "Text",ExpressionUUID->"563d3642-449e-4e12-b643-86e439af8207"],

Cell[BoxData[
 TagBox[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     RowBox[{"epsilon5", "\[LongEqual]", 
      RowBox[{"\[ImaginaryI]", " ", "cEpsilon", " ", "\[Lambda]"}]}], ",", 
     RowBox[{"Gamma5", "\[LongEqual]", 
      RowBox[{
       RowBox[{"-", 
        SuperscriptBox["cEpsilon", "2"]}], " ", 
       SuperscriptBox["\[Lambda]", "2"]}]}], ",", 
     RowBox[{"cEpsilon", ">", "0"}]}], "}"}],
   TraditionalForm],
  TraditionalForm,
  Editable->True]], "Output",ExpressionUUID->"b7761e23-b914-479c-9e90-\
5b4838bccdab"],

Cell["\<\
Because the scalar graph polynomial is parity even, its first transverse \
correction is quadratic:\
\>", "Text",ExpressionUUID->"5cd35b36-3423-4c39-b382-4abbf2209785"],

Cell[BoxData[
 TagBox[
  FormBox[
   RowBox[{"F", "\[LongEqual]", 
    RowBox[{
     RowBox[{
      SuperscriptBox["\[Lambda]", "2"], " ", 
      SubscriptBox["F", "perpendicular"]}], "+", 
     SubscriptBox["F", "0"], "+", 
     RowBox[{"remainder", "(", 
      SuperscriptBox["\[Lambda]", "4"], ")"}]}]}],
   TraditionalForm],
  TraditionalForm,
  Editable->True]], "Output",ExpressionUUID->"8c8adcba-a1fd-499d-8400-\
e45a1837fe95"],

Cell["\<\
Tangential changes of the Mandelstam invariants may be absorbed into the \
coordinates along the Gram surface. The displayed lambda^2 term is the normal \
deformation relevant to the lower-facet test.\
\>", "Text",ExpressionUUID->"3add5df1-3c88-45bc-9ae7-f70a60bfc20c"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     StyleBox["\<\"coordinates\"\>",
      StripOnInput->False,
      FontWeight->Bold], 
     StyleBox["\<\"weights\"\>",
      StripOnInput->False,
      FontWeight->Bold]},
    {"\<\"original (x0,x1,x2,x3,x4,x5; lambda)\"\>", \
"\<\"(-2,-2,-2,-2,-2,-2;1)\"\>"},
    {"\<\"internal (x1,x3,x5)\"\>", "\<\"(-2,-2,-2)\"\>"},
    {"\<\"path normals (fA,fB,fC)\"\>", "\<\"(-1,-1,-1)\"\>"},
    {"\<\"raw F0 before cancellation\"\>", "\<\"W_SL=-6\"\>"},
    {"\<\"resolved F0, U and lambda^2 Fperp\"\>", "\<\"W_HR=-4\"\>"}
   },
   AutoDelete->False,
   GridBoxAlignment->{"Columns" -> {{Left}}},
   GridBoxBackground->{"Columns" -> {{None}}, "Rows" -> {
       RGBColor[0.94, 0.96, 0.99], None}},
   GridBoxFrame->{"Columns" -> {{True}}, "Rows" -> {{True}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}},
   GridBoxSpacings->{"Columns" -> {{1.}}, "Rows" -> {{0.65}}}],
  "Grid"]], "Output",ExpressionUUID->"cb89791d-2f87-4508-8f01-b0918153d2ea"],

Cell["\<\
The scaling vector now fixes the comparison announced above. With lambda \
assigned weight +1, the pullback to the original edge variables is \
(-2,-2,-2,-2,-2,-2;1). Every cubic monomial in F0 has raw weight W_SL=-6. The \
factor Gamma5=O(lambda^2) raises Gamma5 F_Gamma5 to weight -4, while the \
quadratic polynomial U also has weight -4. Cancellation on the singular locus \
promotes F0 to the same resolved weight W_HR=-4: each path scale has weight \
-2 and each normal has weight -1. Thus the cancelled leading sector, the \
first Gram-normal correction and U enter the resolved LP polynomial together.\
\
\>", "Text",ExpressionUUID->"75527e91-734e-4e12-8a60-d207d6817a24"],

Cell[BoxData[
 TagBox[
  FormBox[
   RowBox[{
    SubscriptBox["scriptP", "lead"], "\[LongEqual]", 
    RowBox[{
     RowBox[{
      SuperscriptBox["\[Lambda]", "2"], " ", 
      SubscriptBox["F", "perpendicular"]}], "+", 
     SubscriptBox["U", "Landau"], "+", 
     RowBox[{"qAB", " ", "x5", " ", "yA", " ", "yB"}], "+", 
     RowBox[{"qBC", " ", "x1", " ", "yB", " ", "yC"}], "+", 
     RowBox[{"qCA", " ", "x3", " ", "yA", " ", "yC"}]}]}],
   TraditionalForm],
  TraditionalForm,
  Editable->True]], "Output",ExpressionUUID->"dcaebfc2-82e6-4368-8ea5-\
fa8dca5b1628"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     StyleBox["\<\"source\"\>",
      StripOnInput->False,
      FontWeight->Bold], 
     StyleBox["\<\"weight multiplicities\"\>",
      StripOnInput->False,
      FontWeight->Bold], 
     StyleBox["\<\"terms on leading facet\"\>",
      StripOnInput->False,
      FontWeight->Bold]},
    {"\<\"F0\"\>", 
     StyleBox["\<\"<|-4 -> 3|>\"\>",
      StripOnInput->False,
      FontFamily->"Source Code Pro"], "3"},
    {"\<\"U\"\>", 
     StyleBox["\<\"<|-4 -> 3, -3 -> 6, -2 -> 3|>\"\>",
      StripOnInput->False,
      FontFamily->"Source Code Pro"], "3"},
    {"\<\"lambda^2 Fperp\"\>", 
     StyleBox["\<\"<|-4 -> 1|>\"\>",
      StripOnInput->False,
      FontFamily->"Source Code Pro"], "1"}
   },
   AutoDelete->False,
   GridBoxAlignment->{"Columns" -> {{Left}}},
   GridBoxBackground->{"Columns" -> {{None}}, "Rows" -> {
       RGBColor[0.94, 0.96, 0.99], None}},
   GridBoxFrame->{"Columns" -> {{True}}, "Rows" -> {{True}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}},
   GridBoxSpacings->{"Columns" -> {{1.}}, "Rows" -> {{0.65}}}],
  "Grid"]], "Output",ExpressionUUID->"9741ff07-2d18-4157-b5d2-a9baca686aaf"],

Cell["\<\
This table is produced from the complete transformed F0 and U and the \
leading, generically nonzero normal unfolding of F. Tangential kinematic \
changes contribute only above the certified face. Kinematic coefficients are \
kept as coefficients, so the multiplicities count distinct monomials in the \
six local integration variables and lambda.\
\>", "Text",ExpressionUUID->"90bebac9-834f-4a6d-b9e2-b2e73b88661d"],

Cell["6. Dissection: the ordinary lower-facet description", "Section",ExpressionUUID->"2614f65a-0e40-4b35-9a40-99e05945990d"],

Cell["\<\
Choose local coordinates proportional to fA,fB,fC. The Lee-Pomeransky \
polynomial is then an ordinary polynomial in the three path scales, the three \
normal coordinates and lambda. Its leading augmented exponent points have \
full affine rank six and a one-dimensional normal space. The unique inward \
normal agrees with the proposed scaling, and every other monomial lies on or \
above the same face.\
\>", "Text",ExpressionUUID->"94fe489c-86e1-4de5-99ce-6e10c9a73977"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     StyleBox["\<\"test\"\>",
      StripOnInput->False,
      FontWeight->Bold], 
     StyleBox["\<\"result\"\>",
      StripOnInput->False,
      FontWeight->Bold], 
     StyleBox["\<\"required\"\>",
      StripOnInput->False,
      FontWeight->Bold]},
    {"\<\"leading augmented points\"\>", "7", "\<\"\"\>"},
    {"\<\"affine rank\"\>", "6", "6"},
    {"\<\"normal-space dimension\"\>", "1", "1"},
    {"\<\"inward normal\"\>", 
     StyleBox["\<\"{-2, -2, -2, -1, -1, -1, 1}\"\>",
      StripOnInput->False,
      FontFamily->"Source Code Pro"], 
     StyleBox["\<\"{-2, -2, -2, -1, -1, -1, 1}\"\>",
      StripOnInput->False,
      FontFamily->"Source Code Pro"]},
    {"\<\"all remaining monomials above or on facet\"\>", "True", "True"},
    {"\<\"complete lower-facet certificate\"\>", "True", "True"}
   },
   AutoDelete->False,
   GridBoxAlignment->{"Columns" -> {{Left}}},
   GridBoxBackground->{"Columns" -> {{None}}, "Rows" -> {
       RGBColor[0.94, 0.96, 0.99], None}},
   GridBoxFrame->{"Columns" -> {{True}}, "Rows" -> {{True}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}},
   GridBoxSpacings->{"Columns" -> {{1.}}, "Rows" -> {{0.65}}}],
  "Grid"]], "Output",ExpressionUUID->"a4b1d8ab-1283-4ada-ad45-2b50d98e39f5"],

Cell["\<\
After dissection the hidden cancellation has become an ordinary facet \
problem. The local vector is (-2,-2,-2,-1,-1,-1;1) in the ordered variables \
(x1,x3,x5,fA,fB,fC;lambda). Pulling it back gives the uniform \
original-coordinate vector (-2,-2,-2,-2,-2,-2;1). The hierarchy gap is the \
fixed integer W_HR-W_SL=2.\
\>", "Text",ExpressionUUID->"12cefbba-11ad-49ec-ae92-e6827e9d5e2b"],

Cell[CellGroupData[{

