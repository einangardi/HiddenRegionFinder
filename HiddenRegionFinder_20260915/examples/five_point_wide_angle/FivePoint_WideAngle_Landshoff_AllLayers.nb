 TagBox[GridBox[{
    {
     StyleBox["\<\"internal edge\"\>",
      StripOnInput->False,
      FontWeight->Bold], 
     StyleBox["\<\"Fig. 3 / paper label\"\>",
      StripOnInput->False,
      FontWeight->Bold], 
     StyleBox["\<\"code / this notebook\"\>",
