Cell["\<\
Abstractly, the internal graph is a theta graph: three equivalent two-edge \
paths connect the four-valent vertices carrying p3 and, in the second panel, \
p4. Its path-permutation symmetry remains exact.\
\>", "Text",ExpressionUUID->"b1ec3b86-bee1-4a65-9b2b-33fcb4b871e4"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     StyleBox["\<\"path\"\>",
      StripOnInput->False,
      FontWeight->Bold], 
     StyleBox["\<\"edge pair\"\>",
      StripOnInput->False,
      FontWeight->Bold], 
     StyleBox["\<\"middle external leg\"\>",
      StripOnInput->False,
      FontWeight->Bold], 
     StyleBox["\<\"ratio\"\>",
      StripOnInput->False,
      FontWeight->Bold]},
    {"\<\"A\"\>", "\<\"(x0,x1)\"\>", "\<\"p1\"\>", "\<\"rA=x0/x1\"\>"},
    {"\<\"B\"\>", "\<\"(x2,x3)\"\>", "\<\"p2\"\>", "\<\"rB=x2/x3\"\>"},
    {"\<\"C\"\>", "\<\"(x4,x5)\"\>", "\<\"p5\"\>", "\<\"rC=x4/x5\"\>"}
   },
   AutoDelete->False,
   GridBoxAlignment->{"Columns" -> {{Left}}},
   GridBoxBackground->{"Columns" -> {{None}}, "Rows" -> {
       RGBColor[0.94, 0.96, 0.99], None}},
   GridBoxFrame->{"Columns" -> {{True}}, "Rows" -> {{True}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}},
   GridBoxSpacings->{"Columns" -> {{1.}}, "Rows" -> {{0.65}}}],
  "Grid"]], "Output",ExpressionUUID->"7b6757ab-7136-4c50-b197-eb449f24d822"],

Cell["\<\
The common endpoints carry p3 and p4. The middle vertices of paths A,B,C \
carry p1,p2,p5, respectively. All internal propagators are massless, so U and \
F are multilinear in every original edge variable.\
\>", "Text",ExpressionUUID->"023d8804-1752-4be8-a465-5847f096a851"],

Cell["Part I. Invariant Mandelstam analysis", "Chapter",ExpressionUUID->"704ebfde-4fc3-4873-a316-5cb69068f0c5"],

Cell["2. Exactly massless five-point kinematics", "Section",ExpressionUUID->"521ad56f-5699-4aea-88b8-fadeef08d96a"],

Cell["\<\
All momenta are written in the all-outgoing convention, with p1 and p2 \
incoming physically. Throughout Part I, p_i^2=0 exactly. Five adjacent \
Mandelstam invariants may be used as coordinates; all remain of the same \
wide-angle order. The full physical sign domain is:\
\>", "Text",ExpressionUUID->"1006ac9c-bb43-4b9a-b59f-5e56a0b801d3"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     StyleBox["\<\"class\"\>",
      StripOnInput->False,
      FontWeight->Bold], 
     StyleBox["\<\"invariants\"\>",
      StripOnInput->False,
      FontWeight->Bold], 
     StyleBox["\<\"sign\"\>",
      StripOnInput->False,
      FontWeight->Bold]},
    {"\<\"incoming-incoming\"\>", "\<\"s12\"\>", "\<\">0\"\>"},
    {"\<\"outgoing-outgoing\"\>", "\<\"s34, s45, s35\"\>", "\<\">0\"\>"},
    {"\<\"incoming-outgoing\"\>", "\<\"s23, s15, s13, s14, s24, s25\"\>", "\<\
\"<0\"\>"},
    {"\<\"non-coplanar interior\"\>", "\<\"Gamma5=epsilon5^2\"\>", \
"\<\"Gamma5<0\"\>"},
    {"\<\"chosen orientation\"\>", "\<\"epsilon5/i\"\>", "\<\">0\"\>"}
   },
   AutoDelete->False,
   GridBoxAlignment->{"Columns" -> {{Left}}},
   GridBoxBackground->{"Columns" -> {{None}}, "Rows" -> {
       RGBColor[0.94, 0.96, 0.99], None}},
   GridBoxFrame->{"Columns" -> {{True}}, "Rows" -> {{True}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}},
   GridBoxSpacings->{"Columns" -> {{1.}}, "Rows" -> {{0.65}}}],
  "Grid"]], "Output",ExpressionUUID->"e645821b-d931-4670-bece-34c9e57e2343"],

Cell[BoxData[
 TagBox[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     RowBox[{"s13", "\[LongEqual]", 
      RowBox[{
       RowBox[{"-", "s12"}], "-", "s23", "+", "s45"}]}], ",", 
     RowBox[{"s14", "\[LongEqual]", 
      RowBox[{
       RowBox[{"-", "s15"}], "+", "s23", "-", "s45"}]}], ",", 
     RowBox[{"s24", "\[LongEqual]", 
      RowBox[{"s15", "-", "s23", "-", "s34"}]}], ",", 
     RowBox[{"s25", "\[LongEqual]", 
      RowBox[{
       RowBox[{"-", "s12"}], "-", "s15", "+", "s34"}]}], ",", 
     RowBox[{"s35", "\[LongEqual]", 
      RowBox[{"s12", "-", "s34", "-", "s45"}]}]}], "}"}],
   TraditionalForm],
  TraditionalForm,
  Editable->True]], "Output",ExpressionUUID->"4c0d0d3f-45a4-4249-839b-\
bc82242d7d3d"],

Cell["\<\
To avoid a convention clash with the parity-odd square root, denote the real \
Gram determinant by Gamma5:\
\>", "Text",ExpressionUUID->"19c60f76-97ef-496a-94c7-fba32581b963"],

Cell[BoxData[
 TagBox[
  FormBox[
   RowBox[{"Gamma5", "\[LongEqual]", 
    RowBox[{
     RowBox[{
      SuperscriptBox["s12", "2"], " ", 
      SuperscriptBox["s15", "2"]}], "-", 
     RowBox[{"2", " ", 
      SuperscriptBox["s12", "2"], " ", "s15", " ", "s23"}], "+", 
     RowBox[{
      SuperscriptBox["s12", "2"], " ", 
      SuperscriptBox["s23", "2"]}], "-", 
     RowBox[{"2", " ", "s12", " ", 
      SuperscriptBox["s15", "2"], " ", "s45"}], "+", 
     RowBox[{"2", " ", "s12", " ", "s15", " ", "s23", " ", "s34"}], "+", 
     RowBox[{"2", " ", "s12", " ", "s15", " ", "s23", " ", "s45"}], "+", 
     RowBox[{"2", " ", "s12", " ", "s15", " ", "s34", " ", "s45"}], "-", 
     RowBox[{"2", " ", "s12", " ", 
      SuperscriptBox["s23", "2"], " ", "s34"}], "+", 
     RowBox[{"2", " ", "s12", " ", "s23", " ", "s34", " ", "s45"}], "+", 
     RowBox[{
      SuperscriptBox["s15", "2"], " ", 
      SuperscriptBox["s45", "2"]}], "+", 
     RowBox[{"2", " ", "s15", " ", "s23", " ", "s34", " ", "s45"}], "-", 
     RowBox[{"2", " ", "s15", " ", "s34", " ", 
      SuperscriptBox["s45", "2"]}], "+", 
     RowBox[{
      SuperscriptBox["s23", "2"], " ", 
      SuperscriptBox["s34", "2"]}], "-", 
     RowBox[{"2", " ", "s23", " ", 
      SuperscriptBox["s34", "2"], " ", "s45"}], "+", 
     RowBox[{
      SuperscriptBox["s34", "2"], " ", 
      SuperscriptBox["s45", "2"]}]}], "\[LongEqual]", 
    SuperscriptBox["epsilon5", "2"]}],
   TraditionalForm],
  TraditionalForm,
  Editable->True]], "Output",ExpressionUUID->"eda7dc53-eaaf-4ed1-be53-\
117a2ed78099"],

Cell[BoxData[
 TagBox[
  FormBox[
   RowBox[{"epsilon5", "\[LongEqual]", 
    RowBox[{"4", " ", "\[ImaginaryI]", " ", 
     RowBox[{"LeviCivita", "(", 
      RowBox[{"p1", ",", "p2", ",", "p3", ",", "p4"}], ")"}]}]}],
   TraditionalForm],
  TraditionalForm,
  Editable->True]], "Output",ExpressionUUID->"97fcefb5-0b5a-4dd2-92fb-\
5d2f791ccd15"],

Cell["\<\
For real physical momenta epsilon5 is purely imaginary. Our orientation is \
epsilon5/i=+Sqrt[-Gamma5], so Gamma5<0 in the non-coplanar interior. The \
Landau surface is the coplanar boundary Gamma5=0, approached physically as \
Gamma5->0 from below and epsilon5/i->0 from above. This statement is entirely \
invariant.\
\>", "Text",ExpressionUUID->"64676c67-14e1-46e7-93ca-8f99b199577a"],

Cell[BoxData[
 TagBox[
  FormBox[
   RowBox[{"(", "\[NoBreak]", GridBox[{
      {"0", "s12", 
       RowBox[{
        RowBox[{"-", "s12"}], "-", "s23", "+", "s45"}], 
       RowBox[{
        RowBox[{"-", "s15"}], "+", "s23", "-", "s45"}]},
      {"s12", "0", "s23", 
       RowBox[{"s15", "-", "s23", "-", "s34"}]},
      {
       RowBox[{
        RowBox[{"-", "s12"}], "-", "s23", "+", "s45"}], "s23", "0", "s34"},
      {
       RowBox[{
        RowBox[{"-", "s15"}], "+", "s23", "-", "s45"}], 
       RowBox[{"s15", "-", "s23", "-", "s34"}], "s34", "0"}
     },
     GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
     GridBoxSpacings->{"Columns" -> {
         Offset[0.27999999999999997`], {
          Offset[0.7]}, 
         Offset[0.27999999999999997`]}, "Rows" -> {
         Offset[0.2], {
          Offset[0.4]}, 
         Offset[0.2]}}], "\[NoBreak]", ")"}],
   TraditionalForm],
  TraditionalForm,
  Editable->True]], "Output",ExpressionUUID->"8f95175f-fb0d-4d85-8557-\
85f31eea919c"],

Cell[BoxData[
 TagBox[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      SuperscriptBox["s12", "2"], " ", 
      SuperscriptBox["s15", "2"]}], "-", 
     RowBox[{"2", " ", 
      SuperscriptBox["s12", "2"], " ", "s15", " ", "s23"}], "+", 
     RowBox[{
      SuperscriptBox["s12", "2"], " ", 
      SuperscriptBox["s23", "2"]}], "-", 
     RowBox[{"2", " ", "s12", " ", 
      SuperscriptBox["s15", "2"], " ", "s45"}], "+", 
     RowBox[{"2", " ", "s12", " ", "s15", " ", "s23", " ", "s34"}], "+", 
     RowBox[{"2", " ", "s12", " ", "s15", " ", "s23", " ", "s45"}], "+", 
     RowBox[{"2", " ", "s12", " ", "s15", " ", "s34", " ", "s45"}], "-", 
     RowBox[{"2", " ", "s12", " ", 
      SuperscriptBox["s23", "2"], " ", "s34"}], "+", 
     RowBox[{"2", " ", "s12", " ", "s23", " ", "s34", " ", "s45"}], "+", 
     RowBox[{
      SuperscriptBox["s15", "2"], " ", 
      SuperscriptBox["s45", "2"]}], "+", 
     RowBox[{"2", " ", "s15", " ", "s23", " ", "s34", " ", "s45"}], "-", 
     RowBox[{"2", " ", "s15", " ", "s34", " ", 
      SuperscriptBox["s45", "2"]}], "+", 
     RowBox[{
      SuperscriptBox["s23", "2"], " ", 
      SuperscriptBox["s34", "2"]}], "-", 
     RowBox[{"2", " ", "s23", " ", 
      SuperscriptBox["s34", "2"], " ", "s45"}], "+", 
     RowBox[{
      SuperscriptBox["s34", "2"], " ", 
      SuperscriptBox["s45", "2"]}]}], "\[LongEqual]", "0"}],
   TraditionalForm],
  TraditionalForm,
  Editable->True]], "Output",ExpressionUUID->"bf3b2153-d7d8-48cc-9221-\
f8028151a24b"],

Cell["\<\
In this notebook F denotes the complete massless on-shell second Symanzik \
polynomial. For the chosen near-planar expansion, F0=F|_(Gamma5=0) is the \
leading polynomial and the normal correction begins at Gamma5=O(lambda^2). No \
external off-shell regulator is introduced.\
\>", "Text",ExpressionUUID->"dee54503-58a5-4939-95c5-8ff2cd7f62ff"],

Cell["2.1 Manifestly symmetric graph polynomials", "Subsection",ExpressionUUID->"e007b345-a4b4-45e5-bb98-a3c92f7570c0"],

Cell[BoxData[
 TagBox[
  FormBox[
   RowBox[{"U", "\[LongEqual]", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"x0", "+", "x1"}], ")"}], " ", 
      RowBox[{"(", 
       RowBox[{"x2", "+", "x3"}], ")"}]}], "+", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"x0", "+", "x1"}], ")"}], " ", 
      RowBox[{"(", 
       RowBox[{"x4", "+", "x5"}], ")"}]}], "+", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"x2", "+", "x3"}], ")"}], " ", 
      RowBox[{"(", 
       RowBox[{"x4", "+", "x5"}], ")"}]}]}]}],
   TraditionalForm],
  TraditionalForm,
  Editable->True]], "Output",ExpressionUUID->"1813278a-0d1f-4bae-8048-\
68cd95fcfc07"],

Cell["Introduce one dimensionless ratio on each path:", "Text",ExpressionUUID->"dbf9149e-60bb-42a6-a08d-1ea9890c8152"],

Cell[BoxData[
 TagBox[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     RowBox[{"rA", "\[LongEqual]", 
      FractionBox["x0", "x1"]}], ",", 
     RowBox[{"rB", "\[LongEqual]", 
      FractionBox["x2", "x3"]}], ",", 
     RowBox[{"rC", "\[LongEqual]", 
      FractionBox["x4", "x5"]}]}], "}"}],
   TraditionalForm],
  TraditionalForm,
  Editable->True]], "Output",ExpressionUUID->"7d9c96bb-dd2b-497f-a518-\
1945aaec5b84"],

Cell[BoxData[
 TagBox[
  FormBox[
   RowBox[{
    RowBox[{"\[CapitalPhi]", "(", 
     RowBox[{"rA", ",", "rB", ",", "rC"}], ")"}], "\[LongEqual]", 
    RowBox[{
     RowBox[{"ellA", " ", "rA"}], "+", 
     RowBox[{"ellB", " ", "rB"}], "+", 
     RowBox[{"ellC", " ", "rC"}], "+", 
     RowBox[{"qAB", " ", "rA", " ", "rB"}], "+", 
     RowBox[{"qBC", " ", "rB", " ", "rC"}], "+", 
     RowBox[{"qCA", " ", "rA", " ", "rC"}]}]}],
   TraditionalForm],
  TraditionalForm,
  Editable->True]], "Output",ExpressionUUID->"14b542d6-5171-48fe-b4c4-\
b16f15ab2344"],

Cell[BoxData[
 TagBox[
  FormBox[
   RowBox[{"F", "\[LongEqual]", 
    RowBox[{"x1", " ", "x3", " ", "x5", " ", 
     RowBox[{"\[CapitalPhi]", "(", 
      RowBox[{"rA", ",", "rB", ",", "rC"}], ")"}]}]}],
   TraditionalForm],
  TraditionalForm,
  Editable->True]], "Output",ExpressionUUID->"f660e31c-664f-4e71-8d6b-\
32bb5fb520cf"],

Cell["\<\
The function \[CapitalPhi] is only a convenient dimensionless ratio \
polynomial obtained by factoring x1 x3 x5 out of F. It is not another graph \
polynomial.\
\>", "Text",ExpressionUUID->"65e1da66-b602-41ab-97bc-19d98b9453fd"],

Cell["\<\
All kinematic dependence is contained in six coefficients expressed only \
through adjacent invariants:\
\>", "Text",ExpressionUUID->"62ac9434-6ee2-45d1-acb6-3391d616285e"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     StyleBox["\<\"coefficient\"\>",
      StripOnInput->False,
      FontWeight->Bold], 
     StyleBox["\<\"invariants\"\>",
      StripOnInput->False,
      FontWeight->Bold]},
    {"qAB", 
     RowBox[{"s12", "-", "s34", "-", "s45"}]},
    {"qBC", 
     RowBox[{
      RowBox[{"-", "s12"}], "-", "s23", "+", "s45"}]},
    {"qCA", "s23"},
    {"ellA", 
     RowBox[{
      RowBox[{"-", "s15"}], "+", "s23", "-", "s45"}]},
    {"ellB", 
     RowBox[{"s15", "-", "s23", "-", "s34"}]},
    {"ellC", "s45"}
   },
   AutoDelete->False,
   GridBoxAlignment->{"Columns" -> {{Left}}},
   GridBoxBackground->{"Columns" -> {{None}}, "Rows" -> {
       RGBColor[0.94, 0.96, 0.99], None}},
   GridBoxFrame->{"Columns" -> {{True}}, "Rows" -> {{True}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}},
   GridBoxSpacings->{"Columns" -> {{1.}}, "Rows" -> {{0.65}}}],
  "Grid"]], "Output",ExpressionUUID->"95957aca-adac-4a26-877f-a7822bc633a5"],

Cell["\<\
Only their ratios matter. If a dimensionless parametrization is preferred, \
divide all six coefficients and all s_ij by the common scale s12; none of the \
stationary equations or generator statements changes.\
\>", "Text",ExpressionUUID->"245f5f65-5fbd-4393-8d4a-882ed7f5d7e1"],

Cell["\<\
The form of U and \[CapitalPhi] is covariant under permutations of A,B,C. \
Relabelling the corresponding external legs simply permutes the q and ell \
coefficients.\
\>", "Text",ExpressionUUID->"3b5da228-3e26-429c-be81-585685a28aa9"],

Cell[CellGroupData[{

Cell["Expanded on-shell F, if required", "Subsection",ExpressionUUID->"e0c8c6b9-ab4d-4d59-879d-348c7bbe0fdd"],

Cell[BoxData[
 TagBox[
  FormBox[
   RowBox[{
    RowBox[{"s12", " ", "x0", " ", "x2", " ", "x5"}], "-", 
    RowBox[{"s12", " ", "x1", " ", "x2", " ", "x4"}], "-", 
    RowBox[{"s15", " ", "x0", " ", "x3", " ", "x5"}], "+", 
    RowBox[{"s15", " ", "x1", " ", "x2", " ", "x5"}], "+", 
    RowBox[{"s23", " ", "x0", " ", "x3", " ", "x4"}], "+", 
    RowBox[{"s23", " ", "x0", " ", "x3", " ", "x5"}], "-", 
    RowBox[{"s23", " ", "x1", " ", "x2", " ", "x4"}], "-", 
    RowBox[{"s23", " ", "x1", " ", "x2", " ", "x5"}], "-", 
    RowBox[{"s34", " ", "x0", " ", "x2", " ", "x5"}], "-", 
    RowBox[{"s34", " ", "x1", " ", "x2", " ", "x5"}], "-", 
    RowBox[{"s45", " ", "x0", " ", "x2", " ", "x5"}], "-", 
    RowBox[{"s45", " ", "x0", " ", "x3", " ", "x5"}], "+", 
    RowBox[{"s45", " ", "x1", " ", "x2", " ", "x4"}], "+", 
    RowBox[{"s45", " ", "x1", " ", "x3", " ", "x4"}]}],
   TraditionalForm],
  TraditionalForm,
  Editable->True]], "Output",ExpressionUUID->"0adf2953-e5eb-4409-a7e4-\
3e70df3c597b"]
}, Closed]],

Cell["3. Positive Landau locus in invariant variables", "Section",ExpressionUUID->"d8059c92-df65-4f59-81cd-afcce09de82a"],

Cell["\<\
The variables x1,x3,x5 are convenient positive coordinates for the common \
magnitude on each two-edge path: x0=rA x1, x2=rB x3 and x4=rC x5. They are \
not fixed overall constants; together with the ratios they form six \
independent coordinates on the positive Schwinger orthant. Since F=x1 x3 x5 \
\[CapitalPhi](r), the ratio part of the Landau equations is grad_r \
\[CapitalPhi]=0. Explicit differentiation gives grad_r \[CapitalPhi]=K.r+ell: \
for example, d\[CapitalPhi]/drA=qAB rB+qCA rC+ellA. Therefore at the \
stationary ratio r=rho one obtains K.rho=-ell.\
\>", "Text",ExpressionUUID->"19ef1ada-9ffd-4d31-9860-26f78678aaf1"],

Cell[BoxData[
 TagBox[
  FormBox[
   RowBox[{"K", "\[LongEqual]", 
    RowBox[{"(", "\[NoBreak]", GridBox[{
       {"0", "qAB", "qCA"},
       {"qAB", "0", "qBC"},
       {"qCA", "qBC", "0"}
      },
      GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
      GridBoxSpacings->{"Columns" -> {
          Offset[0.27999999999999997`], {
           Offset[0.7]}, 
          Offset[0.27999999999999997`]}, "Rows" -> {
          Offset[0.2], {
           Offset[0.4]}, 
          Offset[0.2]}}], "\[NoBreak]", ")"}]}],
   TraditionalForm],
  TraditionalForm,
  Editable->True]], "Output",ExpressionUUID->"2ddf465b-0803-4310-99a6-\
679223f6cd0c"],

Cell[BoxData[
 TagBox[
  FormBox[
   RowBox[{
    RowBox[{"K", ".", 
     RowBox[{"{", 
      RowBox[{"rhoA", ",", "rhoB", ",", "rhoC"}], "}"}]}], "\[LongEqual]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", "ellA"}], ",", 
      RowBox[{"-", "ellB"}], ",", 
      RowBox[{"-", "ellC"}]}], "}"}]}],
   TraditionalForm],
  TraditionalForm,
  Editable->True]], "Output",ExpressionUUID->"803a2c94-7da4-49d8-8cd9-\
770c9dded4cb"],

Cell["\<\
This linear system determines rho uniquely whenever qAB qBC qCA is nonzero. \
There is no advantage in displaying the lengthy components of K^(-1) ell \
individually.\
\>", "Text",ExpressionUUID->"561a1a2b-c3dc-4562-8462-e08fa5bb9b01"],

Cell["\<\
At this generic kinematic point, before imposing any coplanar or MRK limit, \
define the three normal polynomials\
\>", "Text",ExpressionUUID->"2eed8a1f-40ac-4d2b-809a-4e4741cbf0c4"],

Cell[BoxData[
 TagBox[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     RowBox[{"fA", "\[LongEqual]", 
      RowBox[{"x0", "-", 
       RowBox[{"rhoA", " ", "x1"}]}]}], ",", 
     RowBox[{"fB", "\[LongEqual]", 
      RowBox[{"x2", "-", 
       RowBox[{"rhoB", " ", "x3"}]}]}], ",", 
     RowBox[{"fC", "\[LongEqual]", 
      RowBox[{"x4", "-", 
       RowBox[{"rhoC", " ", "x5"}]}]}]}], "}"}],
   TraditionalForm],
  TraditionalForm,
  Editable->True]], "Output",ExpressionUUID->"84351b0c-aa39-4bf1-9d7d-\
1c7b13e26d39"],

Cell[BoxData[
 TagBox[
  FormBox[
   RowBox[{
    RowBox[{"\[CapitalPhi]", "(", 
     RowBox[{"rhoA", ",", "rhoB", ",", "rhoC"}], ")"}], "\[LongEqual]", 
    FractionBox["Gamma5", 
     RowBox[{"4", " ", "qAB", " ", "qBC", " ", "qCA"}]]}],
   TraditionalForm],
  TraditionalForm,
  Editable->True]], "Output",ExpressionUUID->"00baf4df-df6d-46b3-8d8c-\
0dfc1f97e729"],

Cell["\<\
This is not a second \[CapitalPhi]: it is the same function evaluated at its \
stationary point r=rho. Completing the quadratic form about rho gives an \
exact identity for the full massless F at generic five-point kinematics:\
\>", "Text",ExpressionUUID->"098bec80-2679-4f3b-b6b5-3aa711f5773f"],

Cell[BoxData[
 TagBox[
  FormBox[
   RowBox[{"F", "\[LongEqual]", 
    RowBox[{
     RowBox[{"fA", " ", "fB", " ", "qAB", " ", "x5"}], "+", 
     RowBox[{"fA", " ", "fC", " ", "qCA", " ", "x3"}], "+", 
     RowBox[{"fB", " ", "fC", " ", "qBC", " ", "x1"}], "+", 
     FractionBox[
      RowBox[{"Gamma5", " ", "x1", " ", "x3", " ", "x5"}], 
      RowBox[{"4", " ", "qAB", " ", "qBC", " ", "qCA"}]]}]}],
   TraditionalForm],
  TraditionalForm,
  Editable->True]], "Output",ExpressionUUID->"c0dea40b-ff10-40c3-9926-\
181696794a44"],

Cell["Analytic check from the Mandelstam polynomial", "Subsection",ExpressionUUID->"6a1db278-98ee-4c42-86c8-9a6dc02a420b"],

Cell["\<\
The following executable check starts from the usual expanded on-shell \
Symanzik polynomial in the adjacent Mandelstam invariants, stored under \
Graph/F0 and displayed in the closed subsection of Sec. 2. It then \
substitutes the explicit invariant q coefficients, the exact solution \
rho=-K^(-1).ell, the definitions of fA,fB,fC, and the Gram polynomial. No use \
is made of the ratio-form identity being tested.\
\>", "Text",ExpressionUUID->"b5218afd-03bb-49ea-85ca-65d92a4886a1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Fmandelstam", "=", 
   RowBox[{"Expand", "[", 
    RowBox[{"landshoffAudit", "[", 
     RowBox[{"\"\<Graph\>\"", ",", "\"\<F0\>\""}], "]"}], "]"}]}], ";", 
  RowBox[{"qRules", "=", 
   RowBox[{"Normal", "[", 
    RowBox[{"landshoffAudit", "[", 
     RowBox[{"\"\<InvariantSymmetricForm\>\"", 
      ",", "\"\<QuadraticCoefficients\>\""}], "]"}], "]"}]}], ";", 
  RowBox[{"rhoRules", "=", 
   RowBox[{"Thread", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"rhoA", ",", "rhoB", ",", "rhoC"}], "}"}], "\[Rule]", 
     RowBox[{"landshoffAudit", "[", 
      RowBox[{"\"\<InvariantSymmetricForm\>\"", 
       ",", "\"\<StationaryRatioVector\>\""}], "]"}]}], "]"}]}], ";", 
  RowBox[{"fRules", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"fA", "\[Rule]", 
      RowBox[{"x0", "-", 
       RowBox[{"rhoA", " ", "x1"}]}]}], ",", 
     RowBox[{"fB", "\[Rule]", 
      RowBox[{"x2", "-", 
       RowBox[{"rhoB", " ", "x3"}]}]}], ",", 
     RowBox[{"fC", "\[Rule]", 
      RowBox[{"x4", "-", 
       RowBox[{"rhoC", " ", "x5"}]}]}]}], "}"}]}], ";", 
  RowBox[{"gammaRule", "=", 
   RowBox[{"Gamma5", "\[Rule]", 
    RowBox[{"hrf5WAGramDeterminant", "[", "]"}]}]}], ";", 
  RowBox[{"rhs", "=", 
   RowBox[{
    RowBox[{"qAB", " ", "x5", " ", "fA", " ", "fB"}], "+", 
    RowBox[{"qBC", " ", "x1", " ", "fB", " ", "fC"}], "+", 
    RowBox[{"qCA", " ", "x3", " ", "fC", " ", "fA"}], "+", 
    FractionBox[
     RowBox[{"Gamma5", " ", "x1", " ", "x3", " ", "x5"}], 
     RowBox[{"4", " ", "qAB", " ", "qBC", " ", "qCA"}]]}]}], ";", 
  RowBox[{"Factor", "[", 
   RowBox[{"Together", "[", 
    RowBox[{"Fmandelstam", "-", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"rhs", "/.", "\[VeryThinSpace]", "fRules"}], "/.", 
         "\[VeryThinSpace]", "rhoRules"}], "/.", "\[VeryThinSpace]", 
        "qRules"}], "/.", "\[VeryThinSpace]", "gammaRule"}], ")"}]}], "]"}], 
   "]"}]}]], "Input",ExpressionUUID->"be45c332-b0e4-4c37-a964-0333a47d263f"],

Cell[BoxData["0"], "Output",ExpressionUUID->"8b8e1df0-f305-4ad7-8b27-c1f6dd1bceae"],

Cell["\<\
The zero is an exact symbolic identity for generic adjacent Mandelstam \
invariants; no numerical kinematic point or coplanar restriction has been \
used.\
\>", "Text",ExpressionUUID->"0f2c217f-8606-46a7-9676-76695932042e"],

Cell["What the derivative harvester sees", "Subsection",ExpressionUUID->"f6009f59-7c8c-4a18-ab4c-ddf35bea9205"],

Cell["\<\
The compact factorized identity must not be confused with the algorithmic \
input. Starting from the usual Mandelstam polynomial, the raw first \
derivative is\
\>", "Text",ExpressionUUID->"6f3ffa61-0ce1-4053-a0da-97a89183db0d"],

Cell[BoxData[
 TagBox[
  FormBox[
   RowBox[{
    SubscriptBox["D", "0"], "\[LongEqual]", 
    RowBox[{
     RowBox[{"ellA", " ", "x3", " ", "x5"}], "+", 
     RowBox[{"qAB", " ", "x2", " ", "x5"}], "+", 
     RowBox[{"qCA", " ", "x3", " ", "x4"}]}]}],
   TraditionalForm],
  TraditionalForm,
  Editable->True]], "Output",ExpressionUUID->"786eaee3-31f0-4cea-b84b-\
ab8bb07ab54d"],

Cell["\<\
Literal collection in qAB, qCA and ellA exposes only monomials. The first \
component of K.rho=-ell gives ellA=-qAB rhoB-qCA rhoC, and only then can the \
same derivative be reorganized as\
\>", "Text",ExpressionUUID->"abcbf504-311a-4282-9c60-46539aa27105"],

Cell[BoxData[
 TagBox[
  FormBox[
   RowBox[{
    SubscriptBox["D", "0"], "\[LongEqual]", 
    RowBox[{
     RowBox[{"qAB", " ", "x5", " ", 
      RowBox[{"(", 
       RowBox[{"x2", "-", 
        RowBox[{"rhoB", " ", "x3"}]}], ")"}]}], "+", 
     RowBox[{"qCA", " ", "x3", " ", 
      RowBox[{"(", 
       RowBox[{"x4", "-", 
        RowBox[{"rhoC", " ", "x5"}]}], ")"}]}]}], "\[LongEqual]", 
    RowBox[{
     RowBox[{"fB", " ", "qAB", " ", "x5"}], "+", 
     RowBox[{"fC", " ", "qCA", " ", "x3"}]}]}],
   TraditionalForm],
  TraditionalForm,
  Editable->True]], "Output",ExpressionUUID->"98745ab6-78ae-4a8a-891c-\
3856b1c885b0"],

Cell["\<\
Thus the simple appearance of fB and fC has already used the stationary \
reorganisation. On Gamma5=0 the complete leading polynomial is the selected \
cancellation sector, so its candidate-specific saturated gradient ideal may \
derive this consequence of the raw derivatives after localising away from the \
nonzero determinant, without supplying rho in advance. This would not be a \
valid pre-decomposition operation on a polynomial that still contained an \
obstruction.\
\>", "Text",ExpressionUUID->"d27b04e5-26fb-487d-bd2a-a66610390353"],

Cell["\<\
The Gamma5 remainder is independent of x0,x2,x4. Hence three derivatives of \
the full F, with no restriction to Gamma5=0, are\
\>", "Text",ExpressionUUID->"4a334a39-e650-4fb4-b229-3c8c03a96efd"],

Cell[BoxData[
 TagBox[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      TagBox[
       FractionBox[
        RowBox[{"\[PartialD]", "F"}], 
        RowBox[{"\[PartialD]", "x0"}],
        MultilineFunction->None],
       "InactiveDTraditional"], "\[LongEqual]", 
      RowBox[{
       RowBox[{"fB", " ", "qAB", " ", "x5"}], "+", 
       RowBox[{"fC", " ", "qCA", " ", "x3"}]}]}], ",", 
     RowBox[{
      TagBox[
       FractionBox[
        RowBox[{"\[PartialD]", "F"}], 
        RowBox[{"\[PartialD]", "x2"}],
        MultilineFunction->None],
       "InactiveDTraditional"], "\[LongEqual]", 
      RowBox[{
       RowBox[{"fA", " ", "qAB", " ", "x5"}], "+", 
       RowBox[{"fC", " ", "qBC", " ", "x1"}]}]}], ",", 
     RowBox[{
      TagBox[
       FractionBox[
        RowBox[{"\[PartialD]", "F"}], 
        RowBox[{"\[PartialD]", "x4"}],
        MultilineFunction->None],
       "InactiveDTraditional"], "\[LongEqual]", 
      RowBox[{
       RowBox[{"fA", " ", "qCA", " ", "x3"}], "+", 
       RowBox[{"fB", " ", "qBC", " ", "x1"}]}]}]}], "}"}],
   TraditionalForm],
  TraditionalForm,
  Editable->True]], "Output",ExpressionUUID->"7d7ba1ee-2857-4cb8-972d-\
25f69cbb0aa3"],

Cell["\<\
Their coefficient matrix in (fA,fB,fC) has determinant 2 qAB qBC qCA x1 x3 \
x5. In the interior positive orthant it therefore forces fA=fB=fC=0. On that \
locus the remaining derivatives are Gamma5 (x3 x5,x1 x5,x1 x3)/(4 qAB qBC \
qCA), and F itself is Gamma5 x1 x3 x5/(4 qAB qBC qCA). Thus the full \
derivative system first exposes the candidate normal ideal and then requires \
Gamma5=0 for an actual pinch.\
\>", "Text",ExpressionUUID->"fae37233-d67e-4cbf-9cff-3f246a9f8e56"],

Cell["\<\
First-sheet Schwinger positivity selects rhoA,rhoB,rhoC>0. The orientation \
sign of epsilon5 does not enter F, but the physical boundary must be \
reachable from the domain epsilon5/i>0. For example, the following invariant \
point lies on that boundary and satisfies every two-particle sign condition:\
\>", "Text",ExpressionUUID->"7c6d99e4-c041-4a93-a1f1-53b068343606"],

Cell[BoxData[
 TagBox[
  FormBox[
   RowBox[{
    RowBox[{"{", 
     RowBox[{"s12", ",", "s23", ",", "s34", ",", "s45", ",", "s15"}], "}"}], "\[LongEqual]", 
    RowBox[{"{", 
     RowBox[{"45", ",", 
      RowBox[{"-", "3"}], ",", 
      FractionBox["9", "2"], ",", "27", ",", 
      RowBox[{"-", 
       FractionBox["45", "2"]}]}], "}"}]}],
   TraditionalForm],
  TraditionalForm,
  Editable->True]], "Output",ExpressionUUID->"14ec036a-b715-4d64-af0f-\
5d945d239061"],

Cell[BoxData[
 TagBox[
  FormBox[
   RowBox[{
    RowBox[{"{", 
     RowBox[{"rhoA", ",", "rhoB", ",", "rhoC"}], "}"}], "\[LongEqual]", 
    RowBox[{"{", 
     RowBox[{"4", ",", "1", ",", "2"}], "}"}]}],
   TraditionalForm],
  TraditionalForm,
  Editable->True]], "Output",ExpressionUUID->"b6b9c0e4-545d-4799-a8bb-\
fd23654afe92"],

Cell[BoxData[
 TagBox[
  FormBox[
   RowBox[{"Gamma5", "\[LongEqual]", "epsilon5", "\[LongEqual]", "0"}],
   TraditionalForm],
  TraditionalForm,
  Editable->True]], "Output",ExpressionUUID->"0d1fa438-1a54-4f93-8524-\
d41479c6def1"],

Cell[CellGroupData[{

Cell["Exact positive Landau check", "Subsection",ExpressionUUID->"b51e4e77-482c-4e35-8b0a-40f75f77f3d7"],

Cell["\<\
The stored invariant construction verifies the stationary equations, the Gram \
identity and positivity without exposing any dimensionful light-cone \
parametrization.\
\>", "Text",ExpressionUUID->"50211651-8676-4465-8b83-4866b6a60049"],

Cell[BoxData[
 RowBox[{"landshoffAudit", "[", "\"\<InvariantSymmetricForm\>\"", 
  "]"}]], "Input",ExpressionUUID->"7a13279f-424c-4f3b-9809-f280a2206ee2"]
}, Closed]],

Cell["4. Coplanar leading sector and factorized generators", "Section",ExpressionUUID->"da79401d-364b-4cc5-a751-2c05ae974e5a"],

Cell["\<\
Only now specialise the generic construction to the coplanar boundary. The \
cancellation structure remains in the original edge variables and is defined \
before dissection.\
\>", "Text",ExpressionUUID->"69867779-03a0-46fe-9f50-8adde1ab3488"],

Cell["Compact form in the exact dimensionless variables", "Subsection",ExpressionUUID->"543ac76e-0f33-4f72-90e4-339b69ec1e2c"],

Cell["\<\
Define zeta=-1/w and zetabar=-1/wbar. On the coplanar boundary \
zeta=zetabar=xi>0, with X34=p3+/p4+ and X45=p4+/p5+. The three stationary \
ratios then have a particularly transparent form:\
\>", "Text",ExpressionUUID->"f0a907ca-6535-4b2c-a025-de2c1bb5f60a"],

Cell[BoxData[
 TagBox[
  FormBox[
   RowBox[{"R", "\[LongEqual]", 
    FractionBox[
     RowBox[{
      RowBox[{"X45", " ", 
       RowBox[{"(", 
        RowBox[{"xi", "+", "1"}], ")"}]}], "+", "xi"}], 
     RowBox[{
      RowBox[{"X34", " ", "X45", " ", 
       RowBox[{"(", 
        RowBox[{"xi", "+", "1"}], ")"}]}], "+", "1"}]]}],
   TraditionalForm],
  TraditionalForm,
  Editable->True]], "Output",ExpressionUUID->"46d6d956-d989-4cc6-a6b6-\
7a39553686f3"],

Cell[BoxData[
 TagBox[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     RowBox[{"rhoA", "\[LongEqual]", 
      RowBox[{"R", " ", "X34", " ", "xi"}]}], ",", 
     RowBox[{"rhoB", "\[LongEqual]", "R"}], ",", 
     RowBox[{"rhoC", "\[LongEqual]", "xi"}]}], "}"}],
   TraditionalForm],
  TraditionalForm,
  Editable->True]], "Output",ExpressionUUID->"e51a7507-05c5-4f0b-adbf-\
4dd33090d374"],

Cell[BoxData[
 TagBox[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     RowBox[{"fA", "\[LongEqual]", 
      RowBox[{"x0", "-", 
       RowBox[{"R", " ", "x1", " ", "X34", " ", "xi"}]}]}], ",", 
     RowBox[{"fB", "\[LongEqual]", 
      RowBox[{"x2", "-", 
       RowBox[{"R", " ", "x3"}]}]}], ",", 
     RowBox[{"fC", "\[LongEqual]", 
      RowBox[{"x4", "-", 
       RowBox[{"x5", " ", "xi"}]}]}]}], "}"}],
   TraditionalForm],
  TraditionalForm,
  Editable->True]], "Output",ExpressionUUID->"0cd0905e-573c-4a6a-adc2-\
6cfed3ddaef5"],

Cell["\<\
For the physical positive-Landau branch X34>0, X45>0 and xi>0. Therefore R>0 \
and rhoA,rhoB,rhoC are all positive. These expressions are exactly the \
invariant solution K.rho=-ell rewritten in the common five-point variables; \
no MRK hierarchy has been taken.\
\>", "Text",ExpressionUUID->"a8966e10-3dd1-457c-b664-eb2bb4c47564"],

Cell["\<\
The f_i define the Landau locus but are not HRF generators individually: a \
generator must have the factorized structure needed by the Landau equations. \
The three generators are their pairwise products:\
\>", "Text",ExpressionUUID->"f461c445-671b-4e99-8f33-f4c7b4a2e404"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     StyleBox["\<\"generator\"\>",
      StripOnInput->False,
      FontWeight->Bold], 
     StyleBox["\<\"factorized form\"\>",
      StripOnInput->False,
      FontWeight->Bold], 
     StyleBox["\<\"multiplier in F0\"\>",
      StripOnInput->False,
      FontWeight->Bold]},
    {
     SubscriptBox["G", "AB"], 
     RowBox[{"fA", " ", "fB"}], 
     RowBox[{"qAB", " ", "x5"}]},
    {
     SubscriptBox["G", "BC"], 
     RowBox[{"fB", " ", "fC"}], 
     RowBox[{"qBC", " ", "x1"}]},
    {
     SubscriptBox["G", "CA"], 
     RowBox[{"fA", " ", "fC"}], 
     RowBox[{"qCA", " ", "x3"}]}
   },
   AutoDelete->False,
   GridBoxAlignment->{"Columns" -> {{Left}}},
   GridBoxBackground->{"Columns" -> {{None}}, "Rows" -> {
       RGBColor[0.94, 0.96, 0.99], None}},
   GridBoxFrame->{"Columns" -> {{True}}, "Rows" -> {{True}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}},
   GridBoxSpacings->{"Columns" -> {{1.}}, "Rows" -> {{0.65}}}],
  "Grid"]], "Output",ExpressionUUID->"b5e8c7cf-daf0-4d00-b3b3-0e39ee00a85c"],

Cell["\<\
Using kappa for four coordinates tangent to the Gram surface and Gamma5 as a \
local normal coordinate, the chosen kinematic expansion is\
\>", "Text",ExpressionUUID->"a16a764c-f634-4d37-a413-27f1d46b3e09"],

Cell[BoxData[
 TagBox[
  FormBox[
   RowBox[{
    RowBox[{"F", "(", 
     RowBox[{"Gamma5", ",", "kappa"}], ")"}], "\[LongEqual]", 
    RowBox[{
     RowBox[{"Gamma5", " ", 
      RowBox[{
       SubscriptBox["F", "Gamma5"], "(", "kappa", ")"}]}], "+", 
     RowBox[{
      SubscriptBox["F", "0"], "(", "kappa", ")"}], "+", 
     RowBox[{"remainder", "(", 
      SuperscriptBox["Gamma5", "2"], ")"}]}]}],
   TraditionalForm],
  TraditionalForm,
  Editable->True]], "Output",ExpressionUUID->"897cc74a-b689-4625-abf3-\
fec78307a726"],

Cell["\<\
There is no conflict between the nonlinear-looking exact decomposition and \
the linearity of F in Mandelstam invariants. Gamma5 is itself a nonlinear \
polynomial in those invariants. Replacing one Mandelstam variable by Gamma5 \
is a nonlinear change of kinematic coordinates, so \
F_Gamma5=(dF/dGamma5)_kappa contains the corresponding nonlinear Jacobian. \
Equivalently, the rational kinematic dependence of rho=-K^(-1).ell cancels \
between the separate terms of the exact decomposition, restoring the original \
Mandelstam-linear polynomial.\
\>", "Text",ExpressionUUID->"44b8b298-6f92-4d35-a7f0-645b0460d754"],

Cell["\<\
Away from the stationary locus the complete F_Gamma5 depends on the choice of \
tangent coordinates kappa. Its restriction to fA=fB=fC=0 is invariantly fixed \
by the exact decomposition to x1 x3 x5/(4 qAB qBC qCA). This is not an \
obstruction in the technical HRF sense, because it is absent from F0 by the \
definition of the expansion rather than being demoted by the HR scaling. \
Since Gamma5=O(lambda^2), this contribution first appears two powers beyond \
F0. Its precise weight relative to the cancelled leading sector and to U \
follows only after the region vector has been determined below.\
\>", "Text",ExpressionUUID->"4e5d2e52-f86c-461b-809b-a39005406124"],

Cell[BoxData[
 TagBox[
  FormBox[
   RowBox[{
    SubscriptBox["F", "0"], "\[LongEqual]", 
    RowBox[{
     RowBox[{"fA", " ", "fB", " ", "qAB", " ", "x5"}], "+", 
     RowBox[{"fA", " ", "fC", " ", "qCA", " ", "x3"}], "+", 
     RowBox[{"fB", " ", "fC", " ", "qBC", " ", "x1"}]}]}],
   TraditionalForm],
  TraditionalForm,
  Editable->True]], "Output",ExpressionUUID->"0feffc79-3782-496d-80cd-\
dd2ee873e20e"],

Cell["Recovering the path normals from derivatives", "Subsection",ExpressionUUID->"4421eac6-16e4-4185-995e-72a4c9dbb03b"],

Cell["\<\
The stationary-adapted derivatives displayed in Sec. 3 recover the three \
normals after the raw derivatives of the selected Gamma5=0 leading sector \
have been completed inside its saturated gradient ideal. Since qAB=s35, \
qBC=s13 and qCA=s23, the resulting outer sectors expose the normals directly \
up to positive monomial factors. For example, the two sectors in the first \
derivative expose fB and fC. In the Crown this sector form is available \
directly; here the f_i contain kinematic stationary ratios, so the \
reorganisation itself must first be derived.\
\>", "Text",ExpressionUUID->"5e0e2679-f4c1-46cd-bc69-47832f2f309d"],

Cell["\<\
After saturation by the nonzero determinant, the ideal of these three \
derivatives is <fA,fB,fC>. The remaining derivatives select Gamma5=0. Only \
there does substitution into F0 reconstruct the HR generator ideal <fA fB,fB \
fC,fC fA>. Each term contains three distinct edge variables, so the original \
F remains cubic and multi-affine; no x_e^2 occurs. Quadratic powers of local \
variables may arise only after changing coordinates.\
\>", "Text",ExpressionUUID->"7345b5a0-73b3-4025-b7c6-b8d9faf4902f"],

Cell["End-to-end HRF run in the original variables", "Subsection",ExpressionUUID->"ba9375a5-4ed6-4d82-9589-922a22fb553b"],

Cell["\<\
The following run implements the same logic without supplying the three \
normals or their pairwise products. The expansion is first fixed on Gamma5=0; \
there the complete supplied leading polynomial equals the cancellation \
sector, and HRF is explicitly authorised to saturate its gradient ideal. \
Kinematic prefactors that are nonzero in the stated domain are treated as \
units: polynomial division is in the Schwinger variables, with rational \
functions of the Mandelstams as coefficients. The Gram equation certifies \
that the remainder is absent from the leading kinematic surface; its physical \
order lambda^2 is restored separately in the scaling step. This special use \
of saturation is not the general derivative-harvest step for a polynomial \
containing an obstruction.\
\>", "Text",ExpressionUUID->"ebafef22-c74c-430c-b9fe-eed6b3d416c4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"$HRF5WANearPlanarAlgorithmAuditLibraryOnly", "=", "True"}], ";", 
  RowBox[{"Get", "[", 
   RowBox[{"FileNameJoin", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"NotebookDirectory", "[", "]"}], 
      ",", "\"\<HRF_FivePointNearPlanarAlgorithmAudit.wl\>\""}], "}"}], "]"}],
    "]"}], ";", 
  RowBox[{"algorithmResult", "=", 
   RowBox[{"hrf5WANearPlanarAlgorithmAudit", "[", "]"}]}], ";", 
  RowBox[{"algorithmResult", "[", "\"\<Summary\>\"", "]"}]}]], "Input",Express\
ionUUID->"bf7ad977-42b7-4691-bc57-86b089eba3a8"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     StyleBox["\<\"certificate\"\>",
      StripOnInput->False,
      FontWeight->Bold], 
     StyleBox["\<\"value\"\>",
      StripOnInput->False,
      FontWeight->Bold]},
    {"\<\"normal factors recovered\"\>", "3"},
    {"\<\"candidate generator-set histogram\"\>", 
     StyleBox["\<\"<|3 -> 1, 2 -> 3, 1 -> 4|>\"\>",
      StripOnInput->False,
      FontFamily->"Source Code Pro"]},
    {"\<\"valid decompositions\"\>", "1"},
    {"\<\"generators in surviving set\"\>", "3"},
    {"\<\"region vector (v0,...,v5)\"\>", 
     StyleBox["\<\"{-2, -2, -2, -2, -2, -2}\"\>",
      StripOnInput->False,
      FontFamily->"Source Code Pro"]},
    {"\<\"weights (WSL,WHR)\"\>", 
     StyleBox["\<\"{-6, -4}\"\>",
      StripOnInput->False,
      FontFamily->"Source Code Pro"]},
    {"\<\"hidden region / truncated\"\>", 
     StyleBox["\<\"{True, False}\"\>",
      StripOnInput->False,
      FontFamily->"Source Code Pro"]}
   },
