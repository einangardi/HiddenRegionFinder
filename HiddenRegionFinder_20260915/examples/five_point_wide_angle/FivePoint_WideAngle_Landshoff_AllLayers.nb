 RowBox[{"landshoffAudit", "[", 
  RowBox[{"\"\<NearPlanarOnShell\>\"", ",", "\"\<FacetCertificate\>\"", 
   ",", "\"\<LeadingAugmentedRows\>\""}], "]"}]], "Input",ExpressionUUID->\
"0f156238-bcdc-43c4-92f7-ef205b2d7f63"],

